---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { getProjects } from "../../lib/projects";
import {
	BLOG_ID,
	author,
	coverStyle,
	formatDate,
	getThoughts,
	ogImagePath,
	readingTime,
} from "../../lib/thoughts";

export async function getStaticPaths() {
	const posts = await getThoughts();

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			// Newest first, so the "newer" post is the one before it in the list.
			newer: index > 0 ? posts[index - 1] : null,
			older: index < posts.length - 1 ? posts[index + 1] : null,
		},
	}));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// The case studies behind the post, in the order the post lists them.
const allProjects = await getProjects();
const caseStudies = post.data.projects
	.map((slug) => allProjects.find((project) => project.slug === slug))
	.filter((project) => project !== undefined);

const minutes = readingTime(post.body ?? "");
const url = new URL(`/thoughts/${post.id}/`, Astro.site ?? Astro.url).href;

const ogImage = ogImagePath(post);

/*
 * BlogPosting structured data: lets search engines show the date, author and
 * image with the result, and ties the post to the Thoughts blog and to the
 * same person the home page describes.
 */
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"@id": `${url}#post`,
	headline: post.data.title,
	description: post.data.description,
	url,
	mainEntityOfPage: { "@type": "WebPage", "@id": url },
	datePublished: post.data.date.toISOString(),
	dateModified: (post.data.updated ?? post.data.date).toISOString(),
	inLanguage: "en",
	keywords: post.data.tags.join(", "),
	wordCount: (post.body ?? "").trim().split(/\s+/).length,
	image: ogImage && new URL(ogImage, Astro.site ?? Astro.url).href,
	author,
	publisher: author,
	isPartOf: { "@type": "Blog", "@id": BLOG_ID },
};

const share = {
	linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
	x: `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(post.data.title)}`,
};

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
---

<Layout
	title={`${post.data.title} |`}
	description={post.data.description}
	image={ogImage}
	imageWidth={ogImage && 1200}
	imageHeight={ogImage && 630}
	imageAlt={post.data.coverAlt}
	type="article"
	article={{
		published: post.data.date,
		modified: post.data.updated,
		tags: post.data.tags,
	}}
	jsonLd={jsonLd}
>
	<!--
		A centred column, not the left-aligned grid the rest of the site uses:
		reading wants a narrow measure, and a narrow measure stuck to the left of a
		wide screen leaves the page lopsided.
	-->
	<article class="w-full max-w-7xl mx-auto py-[var(--section-gap)]">
		<div class="container mx-auto px-4">
			<div class="mx-auto w-full max-w-[66ch]">
			<header>
				<a href="/thoughts/" class={`${labelClass} hover:underline underline-offset-4`}>
					← thoughts
				</a>

				<h1 class="post-title mt-6">{post.data.title}</h1>

				<p class="mt-5 text-lg leading-relaxed text-palette-brightest-white/70">
					{post.data.description}
				</p>

				<p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-palette-brightest-white/55">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					<span aria-hidden="true">·</span>
					<span>{minutes} min read</span>
					{post.data.updated && (
						<>
							<span aria-hidden="true">·</span>
							<span>updated {formatDate(post.data.updated)}</span>
						</>
					)}
					{post.data.draft && <span class="draft-flag">draft</span>}
				</p>
			</header>

			{
				post.data.cover && (
					<figure
						class="cover-frame mt-12 aspect-[16/10] w-full"
						style={coverStyle(post.data)}
					>
						<Image
							src={post.data.cover}
							alt={post.data.coverAlt ?? ""}
							widths={[480, 800, 1200, 1600]}
							sizes="(max-width: 767px) 100vw, 42rem"
							loading="eager"
						/>
					</figure>
				)
			}

			<div class="prose mt-12">
				<Content />
			</div>

			{
				post.data.tags.length > 0 && (
					<ul class="mt-12 flex flex-wrap gap-2" aria-label="Topics">
						{post.data.tags.map((tag) => (
							<li>
								<a href={`/thoughts/?tag=${encodeURIComponent(tag)}`} class="tag-link">
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}

			<div class="mt-8">
				<p class={labelClass}>Share</p>
				<p class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
					<a href={share.linkedin} target="_blank" rel="noreferrer noopener" class="share-link">
						LinkedIn
					</a>
					<a href={share.x} target="_blank" rel="noreferrer noopener" class="share-link">
						X
					</a>
				</p>
			</div>

			{/*
				Where to go after the post, as two separate blocks with their own
				labels and a line above each: first the work the post is about,
				then the other posts.
			*/}
			{
				caseStudies.length > 0 && (
					<section class="end-block" aria-labelledby="case-study-label">
						<p id="case-study-label" class={labelClass}>
							{caseStudies.length > 1 ? "Full case studies" : "Full case study"}
						</p>
						<ul class="mt-4 space-y-5">
							{caseStudies.map((project) => (
								<li>
									<a href={`/project/${project.slug}/`} class="case-link">
										<span class="case-name">{project.name} →</span>
										<span class="case-tagline">{project.tagline}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				(newer || older) && (
					<nav class="end-block" aria-label="Other posts">
						<p class={labelClass}>More thoughts</p>
						<div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-12">
							{older ? (
								<a href={`/thoughts/${older.id}/`} class="pager">
									<span class="pager-label">← older_post</span>
									<span class="pager-title">{older.data.title}</span>
								</a>
							) : (
								<span class="hidden md:block" />
							)}

							{newer && (
								<a href={`/thoughts/${newer.id}/`} class="pager pager--next md:col-start-2">
									<span class="pager-label">newer_post →</span>
									<span class="pager-title">{newer.data.title}</span>
								</a>
							)}
						</div>
					</nav>
				)
			}
			</div>
		</div>
	</article>
</Layout>

<style>
	/* Smaller than the "Thoughts" heading on the list page, which is the parent
	   of this one and should outrank it. */
	.post-title {
		font-size: 1.875rem;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-palette-brightest-white);
		text-wrap: balance;
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 2.5rem;
		}
	}

	.draft-flag {
		padding: 0.1rem 0.45rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 20%, transparent);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.tag-link {
		display: inline-block;
		padding: 0.375rem 0.75rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		font-size: 0.8rem;
		transition: background-color 0.2s ease;
	}

	.tag-link:hover {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.share-link {
		color: var(--color-palette-brightest-white);
		text-underline-offset: 4px;
	}

	.share-link:hover {
		text-decoration: underline;
	}

	.end-block {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
	}

	.case-link {
		display: block;
	}

	.case-name {
		display: block;
		font-size: 1.25rem;
		color: var(--color-palette-brightest-white);
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
		text-decoration-color: color-mix(in srgb, var(--color-palette-brightest-white) 45%, transparent);
		transition: text-decoration-color 0.2s ease;
	}

	.case-link:hover .case-name,
	.case-link:focus-visible .case-name {
		text-decoration-color: currentColor;
	}

	.case-tagline {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.875rem;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.pager {
		display: block;
	}

	.pager-label {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
	}

	.pager-title {
		display: block;
		margin-top: var(--space-xs);
		color: var(--color-palette-brightest-white);
		line-height: 1.4;
		text-underline-offset: 4px;
	}

	.pager:hover .pager-title,
	.pager:focus-visible .pager-title {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.pager--next {
			text-align: right;
		}
	}
</style>
