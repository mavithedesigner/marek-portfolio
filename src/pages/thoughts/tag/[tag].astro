---
import Layout from "../../../layouts/Layout.astro";
import { formatDate, getThoughts, getThoughtTags, tagSlug } from "../../../lib/thoughts";

export async function getStaticPaths() {
	const posts = await getThoughts();
	const tags = await getThoughtTags();

	return tags.map(({ tag, slug }) => ({
		params: { tag: slug },
		props: {
			label: tag,
			posts: posts.filter((post) => post.data.tags.includes(tag)),
		},
	}));
}

const { label, posts } = Astro.props;

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
---

<Layout
	title={`${label} |`}
	description={`Posts about ${label} by Marek Vicáň.`}
>
	<section class="w-full py-[var(--section-gap)]">
		<div class="mx-auto w-full max-w-[66ch] px-4">
			<header>
				<a href="/thoughts/" class={`${labelClass} hover:underline underline-offset-4`}>
					← thoughts
				</a>
				<h1 class="tag-title mt-6">{label}</h1>
				<p class="mt-3 text-palette-brightest-white/60">
					{posts.length} {posts.length === 1 ? "post" : "posts"}
				</p>
			</header>

			<ol class="post-list mt-[var(--space-3xl)]">
				{
					posts.map((post) => (
						<li>
							<a href={`/thoughts/${post.id}/`} class="post">
								<time
									class="post-meta"
									datetime={post.data.date.toISOString()}
								>
									{formatDate(post.data.date)}
								</time>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-summary">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>
</Layout>

<style>
	.tag-title {
		font-size: 2.25rem;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-palette-brightest-white);
	}

	@media (min-width: 768px) {
		.tag-title {
			font-size: 3rem;
		}
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list li + li {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.post {
		display: block;
	}

	.post-meta {
		display: block;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.post-title {
		margin-top: var(--space-2xs);
		font-size: 1.35rem;
		line-height: 1.3;
		color: var(--color-palette-brightest-white);
		text-underline-offset: 5px;
	}

	.post:hover .post-title,
	.post:hover .post-summary {
		text-decoration: underline;
	}

	.post-summary {
		margin-top: var(--space-2xs);
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
		text-underline-offset: 4px;
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 1.6rem;
		}
	}
</style>
