---
import Layout from "../../../layouts/Layout.astro";
import { formatDate, getThoughts, getThoughtTags } from "../../../lib/thoughts";

export async function getStaticPaths() {
	const posts = await getThoughts();
	const tags = await getThoughtTags();

	return tags.map(({ tag }) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
---

<Layout
	title={`${tag} |`}
	description={`Posts about ${tag} by Marek Vicáň.`}
>
	<section class="w-full max-w-7xl mx-auto py-[var(--section-gap)]">
		<div class="container mx-auto px-4">
			<header class="max-w-[62ch]">
				<a href="/thoughts/" class={`${labelClass} hover:underline underline-offset-4`}>
					← thoughts
				</a>
				<h1 class="mt-6 text-3xl leading-tight text-palette-brightest-white md:text-4xl">
					{tag}
				</h1>
				<p class="mt-3 text-palette-brightest-white/60">
					{posts.length} {posts.length === 1 ? "post" : "posts"}
				</p>
			</header>

			<ol class="post-list mt-16">
				{
					posts.map((post) => (
						<li>
							<a href={`/thoughts/${post.id}/`} class="post">
								<time
									class="post-meta"
									datetime={post.data.date.toISOString()}
								>
									{formatDate(post.data.date)}
								</time>
								<h2 class="post-title">{post.data.title}</h2>
								<p class="post-summary">{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</section>
</Layout>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 62ch;
	}

	.post-list li + li {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.post {
		display: block;
	}

	.post-meta {
		display: block;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.post-title {
		margin-top: var(--space-2xs);
		font-size: 1.35rem;
		line-height: 1.3;
		color: var(--color-palette-brightest-white);
		text-underline-offset: 5px;
	}

	.post:hover .post-title {
		text-decoration: underline;
	}

	.post-summary {
		margin-top: var(--space-2xs);
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 1.6rem;
		}
	}
</style>
