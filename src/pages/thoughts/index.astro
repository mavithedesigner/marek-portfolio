---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getThoughts, getThoughtTags, readingTime } from "../../lib/thoughts";

const posts = await getThoughts();
const tags = await getThoughtTags();

// The newest post leads the page; everything else forms the list underneath.
const [featured, ...rest] = posts;
---

<Layout
	title="Thoughts |"
	description="Notes on design, branding and working with AI, by Marek Vicáň."
>
	<!--
		Unlike the rest of the site, this page is a column centred in the viewport.
		Reading wants a narrow measure, and a narrow measure pinned to the left edge
		of a wide screen leaves the page looking unbalanced.
	-->
	<section class="w-full py-[var(--section-gap)]">
		<div class="mx-auto w-full max-w-[66ch] px-4">
			<header class="text-center">
				<h1 class="page-title">Thoughts</h1>
				<p class="mt-5 text-lg leading-relaxed text-palette-brightest-white/70">
					Notes on design, branding and working with AI. Written when I have
					something worth saying, not on a schedule.
				</p>
			</header>

			{
				tags.length > 0 && (
					<ul class="mt-10 flex flex-wrap justify-center gap-2" aria-label="Topics">
						{tags.map(({ tag, slug, count }) => (
							<li>
								<a href={`/thoughts/tag/${slug}/`} class="tag-link">
									{tag} <span class="count">{count}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>

		{
			posts.length === 0 ? (
				<div class="mx-auto w-full max-w-[66ch] px-4">
					<p class="mt-[var(--space-3xl)] text-center text-palette-brightest-white/60">
						Nothing published yet. The first posts are on their way.
					</p>
				</div>
			) : (
				<div class="mx-auto w-full max-w-[66ch] px-4">
					{/* Lead post: the one thing someone should read if they read one thing. */}
					<a href={`/thoughts/${featured.id}/`} class="featured">
						{featured.data.cover && (
							<Image
								src={featured.data.cover}
								alt={featured.data.coverAlt ?? ""}
								widths={[480, 800, 1200]}
								sizes="(max-width: 768px) 100vw, 66ch"
								loading="eager"
								class="featured-cover"
							/>
						)}

						<span class="meta">
							<time datetime={featured.data.date.toISOString()}>
								{formatDate(featured.data.date)}
							</time>
							<span aria-hidden="true">·</span>
							<span>{readingTime(featured.body ?? "")} min read</span>
							{featured.data.draft && <span class="draft-flag">draft</span>}
						</span>

						<h2 class="featured-title">{featured.data.title}</h2>
						<p class="featured-summary">{featured.data.description}</p>
						<span class="read-on">Read it →</span>
					</a>

					{rest.length > 0 && (
						<ol class="post-list">
							{rest.map((post) => (
								<li>
									<a href={`/thoughts/${post.id}/`} class="post">
										{post.data.cover && (
											<Image
												src={post.data.cover}
												alt=""
												widths={[160, 320]}
												sizes="80px"
												loading="lazy"
												class="post-thumb"
											/>
										)}

										<span class="post-body">
											<span class="meta">
												<time datetime={post.data.date.toISOString()}>
													{formatDate(post.data.date)}
												</time>
												{post.data.draft && <span class="draft-flag">draft</span>}
											</span>
											<span class="post-title">{post.data.title}</span>
											<span class="post-summary">{post.data.description}</span>
										</span>
									</a>
								</li>
							))}
						</ol>
					)}
				</div>
			)
		}
	</section>
</Layout>

<style>
	/* The page title has to outrank every post title on the page, so it is sized
	   like a page heading, not like a label. */
	.page-title {
		font-size: 2.5rem;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-palette-brightest-white);
	}

	@media (min-width: 768px) {
		.page-title {
			font-size: 3.5rem;
		}
	}

	.tag-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.375rem 0.75rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		font-size: 0.8rem;
		transition: background-color 0.2s ease;
	}

	.tag-link:hover {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.count {
		font-size: 0.7rem;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.draft-flag {
		padding: 0.1rem 0.4rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 20%, transparent);
		letter-spacing: 0.1em;
	}

	/* --- lead post ------------------------------------------------------- */

	.featured {
		display: block;
		/* Room to breathe between the filters and the first post. */
		margin-top: var(--space-3xl);
		text-align: center;
	}

	.featured-cover {
		width: 100%;
		height: auto;
		margin-bottom: var(--space-lg);
	}

	.featured .meta {
		justify-content: center;
	}

	.featured-title {
		margin-top: var(--space-xs);
		font-size: 1.75rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-palette-brightest-white);
		text-wrap: balance;
		text-underline-offset: 6px;
	}

	.featured-summary {
		margin-top: var(--space-sm);
		line-height: 1.65;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
		text-underline-offset: 4px;
	}

	.read-on {
		display: inline-block;
		margin-top: var(--space-md);
		font-size: 0.875rem;
		color: var(--color-palette-brightest-white);
		text-underline-offset: 4px;
	}

	/* Hover underlines the whole entry, title and summary alike, so it is obvious
	   the entire block is one link. */
	.featured:hover .featured-title,
	.featured:hover .featured-summary,
	.featured:hover .read-on,
	.featured:focus-visible .featured-title,
	.featured:focus-visible .featured-summary,
	.featured:focus-visible .read-on {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.featured-title {
			font-size: 2.125rem;
		}
	}

	/* --- the rest --------------------------------------------------------- */

	.post-list {
		list-style: none;
		margin: var(--space-3xl) 0 0;
		padding: var(--space-3xl) 0 0;
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.post-list li + li {
		margin-top: var(--space-xl);
		padding-top: var(--space-xl);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.post {
		display: flex;
		align-items: flex-start;
		gap: var(--space-md);
	}

	.post-thumb {
		width: 5rem;
		height: 5rem;
		flex-shrink: 0;
		object-fit: cover;
		filter: grayscale(1);
		opacity: 0.7;
		transition: filter 0.4s ease, opacity 0.4s ease;
	}

	.post:hover .post-thumb {
		filter: grayscale(0);
		opacity: 1;
	}

	.post-body {
		min-width: 0;
	}

	.post-title {
		display: block;
		margin-top: var(--space-2xs);
		font-size: 1.2rem;
		line-height: 1.35;
		color: var(--color-palette-brightest-white);
		text-underline-offset: 5px;
	}

	.post-summary {
		display: block;
		margin-top: var(--space-2xs);
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
		text-underline-offset: 4px;
	}

	.post:hover .post-title,
	.post:hover .post-summary,
	.post:focus-visible .post-title,
	.post:focus-visible .post-summary {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 1.35rem;
		}
	}
</style>
