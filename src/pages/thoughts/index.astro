---
import Layout from "../../layouts/Layout.astro";
import { formatDate, getThoughts, getThoughtTags } from "../../lib/thoughts";

const posts = await getThoughts();
const tags = await getThoughtTags();

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
---

<Layout
	title="Thoughts |"
	description="Notes on design, branding and working with AI, by Marek Vicáň."
>
	<section class="w-full max-w-7xl mx-auto py-[var(--section-gap)]">
		<div class="container mx-auto px-4">
			<header class="max-w-[62ch]">
				<h1 class={labelClass}>Thoughts</h1>
				<p class="mt-4 text-xl leading-relaxed text-palette-brightest-white md:text-2xl">
					Notes on design, branding and working with AI.
				</p>
				<p class="mt-3 text-palette-brightest-white/60">
					Written when I have something worth saying, not on a schedule.
				</p>
			</header>

			{
				tags.length > 0 && (
					<ul class="mt-10 flex flex-wrap gap-2" aria-label="Topics">
						{tags.map(({ tag, count }) => (
							<li>
								<a href={`/thoughts/tag/${tag}/`} class="tag-link">
									{tag} <span class="count">{count}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}

			{
				posts.length === 0 ? (
					<p class="mt-16 text-palette-brightest-white/60">
						Nothing published yet. The first posts are on their way.
					</p>
				) : (
					<ol class="post-list mt-16">
						{posts.map((post) => (
							<li>
								<a href={`/thoughts/${post.id}/`} class="post">
									<span class="post-meta">
										<time datetime={post.data.date.toISOString()}>
											{formatDate(post.data.date)}
										</time>
										{post.data.draft && <span class="draft-flag">draft</span>}
									</span>
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-summary">{post.data.description}</p>
								</a>
							</li>
						))}
					</ol>
				)
			}
		</div>
	</section>
</Layout>

<style>
	/* Clickable, so it carries the same chip as every other button on the site. */
	.tag-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.375rem 0.75rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		font-size: 0.8rem;
		transition: background-color 0.2s ease;
	}

	.tag-link:hover {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.count {
		font-size: 0.7rem;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 62ch;
	}

	/* A rule between entries rather than a box around each one: the list reads as
	   one column of writing, which is the point. */
	.post-list li + li {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.post {
		display: block;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--space-2xs);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.draft-flag {
		padding: 0.1rem 0.4rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 20%, transparent);
		letter-spacing: 0.1em;
	}

	.post-title {
		margin-top: var(--space-2xs);
		font-size: 1.35rem;
		line-height: 1.3;
		color: var(--color-palette-brightest-white);
		text-underline-offset: 5px;
	}

	.post:hover .post-title,
	.post:focus-visible .post-title {
		text-decoration: underline;
	}

	.post-summary {
		margin-top: var(--space-2xs);
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 1.6rem;
		}
	}
</style>
