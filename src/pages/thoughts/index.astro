---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getThoughts, getThoughtTags, readingTime } from "../../lib/thoughts";

const posts = await getThoughts();
const tags = await getThoughtTags();

// The newest post leads the page; everything else sits in the grid below.
const [featured, ...rest] = posts;
---

<Layout
	title="Thoughts |"
	description="Notes on design, branding and working with AI, by Marek Vicáň."
>
	<!-- Same frame as Archive and About, so the left and right edges line up
	     across the whole site. -->
	<section
		class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white pt-[var(--space-2xl)] pb-[var(--section-gap)]"
	>
		<div class="container mx-auto">
			<!-- Search engines and screen readers need a heading; the page itself
			     doesn't, the writing introduces itself. -->
			<h1 class="sr-only">Thoughts</h1>

			{
				posts.length === 0 ? (
					<p class="px-4 text-secondary-foreground">
						Nothing published yet. The first posts are on their way.
					</p>
				) : (
					<>
						{/* Lead post. Hidden by a filter like any other entry. */}
						<a
							href={`/thoughts/${featured.id}/`}
							class="featured px-4"
							data-post
							data-tags={featured.data.tags.join("|")}
						>
							{featured.data.cover && (
								<Image
									src={featured.data.cover}
									alt={featured.data.coverAlt ?? ""}
									widths={[480, 800, 1200, 1600]}
									sizes="(max-width: 1280px) 100vw, 80rem"
									loading="eager"
									class="featured-cover"
								/>
							)}

							<span class="meta">
								<time datetime={featured.data.date.toISOString()}>
									{formatDate(featured.data.date)}
								</time>
								<span aria-hidden="true">·</span>
								<span>{readingTime(featured.body ?? "")} min read</span>
								{featured.data.draft && <span class="draft-flag">draft</span>}
							</span>

							<h2 class="featured-title">{featured.data.title}</h2>
							<p class="featured-summary">{featured.data.description}</p>
						</a>

						{/*
							Topics filter in place, exactly like the archive: no page load,
							the list just narrows. Every post stays in the HTML, so the page
							still works with JavaScript switched off.
						*/}
						{tags.length > 0 && (
							<div class="tag-row px-4" role="group" aria-label="Filter posts by topic" data-tag-filters>
								<button type="button" data-filter="all" aria-pressed="true" class="tag-link">
									All <span class="count">{posts.length}</span>
								</button>
								{tags.map(({ tag, count }) => (
									<button type="button" data-filter={tag} aria-pressed="false" class="tag-link">
										{tag} <span class="count">{count}</span>
									</button>
								))}
							</div>
						)}

						{rest.length > 0 && (
							<ol class="post-grid px-4" data-post-grid>
								{rest.map((post) => (
									<li data-post data-tags={post.data.tags.join("|")}>
										<a href={`/thoughts/${post.id}/`} class="post">
											{post.data.cover && (
												<Image
													src={post.data.cover}
													alt=""
													widths={[400, 800]}
													sizes="(max-width: 768px) 100vw, 36rem"
													loading="lazy"
													class="post-cover"
												/>
											)}

											<span class="meta">
												<time datetime={post.data.date.toISOString()}>
													{formatDate(post.data.date)}
												</time>
												<span aria-hidden="true">·</span>
												<span>{readingTime(post.body ?? "")} min read</span>
												{post.data.draft && <span class="draft-flag">draft</span>}
											</span>

											<span class="post-title">{post.data.title}</span>
											<span class="post-summary">{post.data.description}</span>
										</a>
									</li>
								))}
							</ol>
						)}

						<p class="px-4 mt-10 text-secondary-foreground" data-empty hidden>
							Nothing on that topic yet.
						</p>
					</>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 55%, transparent);
	}

	.draft-flag {
		padding: 0.1rem 0.4rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 20%, transparent);
		letter-spacing: 0.1em;
	}

	[data-post][hidden] {
		display: none;
	}

	/* --- lead post ------------------------------------------------------- */

	.featured {
		display: block;
	}

	/* Capped against the viewport: the lead post has to fit on one screen
	   together with the topics and the first row of the grid below it. */
	.featured-cover {
		width: 100%;
		height: auto;
		max-height: 38svh;
		object-fit: cover;
		margin-bottom: var(--space-lg);
	}

	.featured-title {
		margin-top: var(--space-xs);
		font-size: 2rem;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--color-palette-brightest-white);
		text-wrap: balance;
		text-underline-offset: 6px;
	}

	.featured-summary {
		margin-top: var(--space-sm);
		max-width: 62ch;
		font-size: 1.0625rem;
		line-height: 1.65;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 70%, transparent);
		text-underline-offset: 4px;
	}

	/* The whole entry is one link, so the whole entry reacts. */
	.featured:hover .featured-title,
	.featured:hover .featured-summary,
	.featured:focus-visible .featured-title,
	.featured:focus-visible .featured-summary {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.featured-title {
			font-size: 2.375rem;
		}
	}

	/* --- topics ----------------------------------------------------------- */

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: var(--space-2xl);
		padding-top: var(--space-2xl);
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	.tag-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.375rem 0.75rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		font-size: 0.8rem;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.tag-link:hover {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.tag-link[aria-pressed="true"] {
		background: var(--color-palette-brightest-white);
		color: var(--color-background);
	}

	.count {
		font-size: 0.7rem;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
	}

	.tag-link[aria-pressed="true"] .count {
		color: color-mix(in srgb, var(--color-background) 60%, transparent);
	}

	/* --- the rest, as a grid like the archive ----------------------------- */

	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--card-gutter-y) var(--card-gutter);
		margin: var(--space-2xl) 0 0;
		padding-left: 1rem;
		padding-right: 1rem;
		list-style: none;
	}

	@media (min-width: 768px) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.post {
		display: block;
	}

	.post-cover {
		width: 100%;
		height: auto;
		margin-bottom: var(--space-md);
		filter: grayscale(1);
		opacity: 0.75;
		transition: filter 0.4s ease, opacity 0.4s ease;
	}

	.post:hover .post-cover,
	.post:focus-visible .post-cover {
		filter: grayscale(0);
		opacity: 1;
	}

	.post-title {
		display: block;
		margin-top: var(--space-2xs);
		font-size: 1.25rem;
		line-height: 1.3;
		color: var(--color-palette-brightest-white);
		text-wrap: balance;
		text-underline-offset: 5px;
	}

	.post-summary {
		display: block;
		margin-top: var(--space-2xs);
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
		text-underline-offset: 4px;
	}

	.post:hover .post-title,
	.post:hover .post-summary,
	.post:focus-visible .post-title,
	.post:focus-visible .post-summary {
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.post-title {
			font-size: 1.4rem;
		}
	}
</style>

<script>
	function bindThoughtFilters() {
		const bar = document.querySelector<HTMLElement>("[data-tag-filters]");
		const empty = document.querySelector<HTMLElement>("[data-empty]");
		if (!bar || bar.dataset.bound === "true") return;
		bar.dataset.bound = "true";

		const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter]")];
		const entries = [...document.querySelectorAll<HTMLElement>("[data-post]")];

		function apply(filter: string) {
			let visible = 0;

			for (const entry of entries) {
				const tags = (entry.dataset.tags ?? "").split("|").filter(Boolean);
				const show = filter === "all" || tags.includes(filter);
				entry.hidden = !show;
				if (show) visible++;
			}

			for (const button of buttons) {
				button.setAttribute("aria-pressed", String(button.dataset.filter === filter));
			}

			if (empty) empty.hidden = visible > 0;

			/*
			 * Filtering shortens the page. Lenis holds its own scroll value and
			 * would glide to the new maximum on its next frame, which reads as the
			 * page moving by itself. Freeze it, re-measure, pin the scroll back.
			 */
			const lenis = (window as any).__lenis;
			const root = document.documentElement;
			const before = window.scrollY;

			root.style.scrollBehavior = "auto";
			lenis?.stop?.();

			requestAnimationFrame(() => {
				lenis?.resize?.();
				const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
				const target = Math.min(before, max);
				window.scrollTo(0, target);
				lenis?.scrollTo?.(target, { immediate: true, force: true });
				lenis?.start?.();
				requestAnimationFrame(() => {
					root.style.scrollBehavior = "";
				});
			});
		}

		for (const button of buttons) {
			button.addEventListener("click", (event) => {
				event.preventDefault();
				apply(button.dataset.filter ?? "all");
			});
		}

		// A link like /thoughts/?tag=Branding arrives pre-filtered, which is how
		// the tags under a post get back here.
		const wanted = new URLSearchParams(window.location.search).get("tag");
		if (wanted && buttons.some((b) => b.dataset.filter === wanted)) {
			apply(wanted);
		}
	}

	bindThoughtFilters();
	document.addEventListener("astro:after-swap", bindThoughtFilters);
</script>
