---
import Contact from "../components/Contact.astro";
import Testimonials from "../components/Testimonials.astro";
import Layout from "../layouts/Layout.astro";

const title = "Contact |";
---

<Layout
	title={title}
	description="Get in touch with Marek Vicáň, designer in Bratislava. Send an email, book a 15-minute call, or reach out on LinkedIn."
>
	<div class="w-full max-w-7xl mx-auto text-palette-brightest-white">
		<!--
			The ask has to fit one screen on desktop: nobody should have to scroll
			to find out how to get in touch. svh so mobile browser chrome doesn't
			push the block out of view.
		-->
		<div
			class="flex min-h-[calc(100svh-5.5rem)] flex-col justify-center py-8 lg:py-12"
		>
			<Contact spacing="mt-0 mb-0" />
		</div>

		<!-- Proof, well clear of the ask. Renders only once quotes exist. -->
		<Testimonials class="section-gap section-gap-b" />
	</div>
</Layout>
