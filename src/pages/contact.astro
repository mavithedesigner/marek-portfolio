---
import Contact from "../components/Contact.astro";
import Testimonials from "../components/Testimonials.astro";
import Layout from "../layouts/Layout.astro";

const title = "Contact |";
---

<Layout
	title={title}
	description="Get in touch with Marek Vicáň — designer in Bratislava. Send an email, book a 15-minute call, or reach out on LinkedIn."
>
	<div class="w-full max-w-7xl mx-auto text-palette-brightest-white py-16 min-h-dvh h-full">
		<Contact />
		<!-- Proof sits right next to the ask. Renders only once quotes exist. -->
		<Testimonials limit={3} />
	</div>
</Layout>
