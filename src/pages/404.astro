---
import Layout from "../layouts/Layout.astro";
---

<!--
	Just the line, centred, the same way the loading state looks. It still uses
	the site Layout, so the header and its navigation are there to get back.
-->
<Layout title="404 |" description="404 page not found...">
	<!-- svh, not h-screen: on iOS 100vh includes the hidden browser chrome. -->
	<div
		class="flex min-h-[calc(100svh-5.5rem)] items-center justify-center px-4 text-sm text-palette-brightest-white"
	>
		<p>404 page not found...</p>
	</div>
</Layout>
