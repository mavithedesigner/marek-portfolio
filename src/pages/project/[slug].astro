---
import CallToAction from "../../components/CallToAction.astro";
import ProjectGallery from "../../components/ProjectGallery";
import Testimonials from "../../components/Testimonials.astro";
import Layout from "../../layouts/Layout.astro";
import { getOgImage, getProjects, parseCollaborators } from "../../lib/projects";

export async function getStaticPaths() {
    const projects = await getProjects();

    return projects.map((project, index) => ({
        params: { slug: project.slug },
        props: {
            project,
            index,
            previous: index > 0 ? projects[index - 1] : null,
            next: index < projects.length - 1 ? projects[index + 1] : null,
        },
    }));
}

const { project, previous, next } = Astro.props;

const ogImage = await getOgImage(project.thumbnail);

// With a single image there is no strip to pin or scroll, so the whole
// scroll-driven layout is skipped for that project.
const hasStrip = project.imageItems.length > 1;
const collaborators = parseCollaborators(project.collaborators);
---

<Layout
    title={`${project.name} |`}
    description={`${project.tagline} ${project.name}, ${project.role}, ${project.year}.`}
    image={ogImage}
>
    <!--
        `--header-h` keeps the pinned showcase tucked under the sticky header so
        the navigation stays visible for the whole scroll.
    -->
    <section
        class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white pt-6 pb-6 md:pt-2 md:pb-8 [--header-h:4rem] md:[--header-h:5.5rem]"
    >
        <!-- px-4 everywhere so the header's logo and CTA line up with the content -->
        <div class="px-4">
            <div
                class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10 lg:gap-16 xl:gap-24 items-start"
            >
                <!--
                    Left: scroll-driven showcase.
                    The track is stretched by ProjectGallery to `100svh + strip overflow`,
                    so the pinned strip travels sideways for exactly as long as it needs
                    before the page resumes scrolling.
                -->
                {
                    hasStrip ? (
                        <div data-pin-track class="relative min-w-0">
                            {/* No forced height on mobile: the block hugs the strip so the
                                project copy follows straight after instead of a blank screen. */}
                            <div
                                data-pin-sticky
                                class="sticky top-[var(--header-h)] flex flex-col justify-start pt-2 "
                            >
                                <ProjectGallery client:load images={project.imageItems} />
                            </div>
                        </div>
                    ) : (
                        /* One image: nothing to pin or scroll through, so it just sits
                           at the top of the column at full width. */
                        <div class="min-w-0 pt-2">
                            <ProjectGallery client:load images={project.imageItems} />
                        </div>
                    )
                }

                <!-- Right: Project details — pinned alongside so nothing shifts on desktop -->
                <div
                    class:list={[
                        "flex flex-col gap-6 text-base leading-relaxed max-w-xl lg:pt-2",
                        // Pinning the copy only makes sense while the strip beside it
                        // is being scrolled through.
                        hasStrip &&
                            "lg:sticky lg:top-[var(--header-h)] lg:justify-start",
                    ]}
                >
                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Name
                            </div>
                            <div class="text-palette-brightest-white">
                                {project.name}
                            </div>
                        </div>

                        {project.website && (
                            <div class="space-y-2">
                                <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                    Website
                                </div>
                                <a
                                    href={project.website}
                                    target="_blank"
                                    rel="noreferrer noopener"
                                    class="text-palette-brightest-white hover:underline underline-offset-4"
                                >
                                    {project.websiteLabel ??
                                        project.website
                                            .replace(/^https?:\/\//, "")
                                            .replace(/^www\./, "")
                                            .replace(/\/$/, "")}
                                </a>
                            </div>
                        )}
                    </div>

                    {project.outcome && (
                        <div class="space-y-2 border-l-2 border-palette-brightest-white/40 pl-4">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Outcome
                            </div>
                            <p class="text-palette-brightest-white">
                                {project.outcome}
                            </p>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            About
                        </div>
                        <!-- Split on blank lines so a case study reads as prose,
                             not one intimidating slab of text. -->
                        <div class="space-y-4 text-palette-brightest-white/80">
                            {project.about
                                .split(/\n{2,}/)
                                .map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                    </div>

                    {project.tags.length > 0 && (
                        <div class="space-y-2">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Disciplines
                            </div>
                            <ul class="flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <li class="bg-palette-brightest-white/15 px-2.5 py-1 text-sm text-palette-brightest-white/80">
                                        {tag}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}

                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Client
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.client}
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Year
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.year}
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Role
                        </div>
                        <div class="text-palette-brightest-white/80">
                            {project.role}
                        </div>
                    </div>

                    {project.collaborators && (
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Collaborators
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {collaborators.map((person, i) => (
                                    <>
                                        {i > 0 && ", "}
                                        {person.url ? (
                                            <a
                                                href={person.url}
                                                target="_blank"
                                                rel="noreferrer noopener"
                                                class="hover:text-palette-brightest-white hover:underline underline-offset-4"
                                            >
                                                {person.name}
                                            </a>
                                        ) : (
                                            person.name
                                        )}
                                    </>
                                ))}
                            </div>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Programs
                        </div>
                        <ul class="space-y-1 text-palette-brightest-white/80">
                            {
                                project.programs.map((program) => (
                                    <li>{program}</li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- A quote from this very project, when one exists. Nothing renders otherwise. -->
    <Testimonials
        project={project.slug}
        limit={1}
        heading="What the client said"
        class="section-gap"
    />


    <!--
        The ask comes last, after the case and after the quote: by then someone
        has everything they need to decide. The pager sits above it so "keep
        browsing" stays available without competing with it.
    -->
    <CallToAction />

    <!-- Plain text, last thing on the page: a way out for anyone still browsing,
         without competing with the contact block above it. -->
    <nav
        class="w-full max-w-7xl mx-auto mt-[var(--space-3xl)]"
        aria-label="Other projects"
    >
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between gap-4 text-sm font-mono">
                {
                    previous ? (
                        <a
                            href={`/project/${previous.slug}`}
                            class="text-palette-brightest-white hover:underline underline-offset-4"
                        >
                            ← previous_project
                        </a>
                    ) : (
                        <span class="text-palette-brightest-white/30">← previous_project</span>
                    )
                }

                {
                    next ? (
                        <a
                            href={`/project/${next.slug}`}
                            class="text-palette-brightest-white hover:underline underline-offset-4"
                        >
                            next_project →
                        </a>
                    ) : (
                        <span class="text-palette-brightest-white/30">next_project →</span>
                    )
                }
            </div>
        </div>
    </nav>
</Layout>

<script is:inline>
	// Open every project at the top. The gallery is driven by page scroll, so a
	// restored scroll position used to drop people in the middle of the strip.
	if ("scrollRestoration" in history) {
		history.scrollRestoration = "manual";
	}
</script>

