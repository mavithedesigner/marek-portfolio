---
import CallToAction from "../../components/CallToAction.astro";
import ProjectGallery from "../../components/ProjectGallery";
import Testimonials from "../../components/Testimonials.astro";
import Layout from "../../layouts/Layout.astro";
import { getOgImage, getProjects } from "../../lib/projects";

export async function getStaticPaths() {
    const projects = await getProjects();

    return projects.map((project, index) => ({
        params: { slug: project.slug },
        props: {
            project,
            index,
            previous: index > 0 ? projects[index - 1] : null,
            next: index < projects.length - 1 ? projects[index + 1] : null,
        },
    }));
}

const { project, previous, next } = Astro.props;

const ogImage = await getOgImage(project.thumbnail);
---

<Layout
    title={`${project.name} |`}
    description={`${project.tagline} ${project.name} — ${project.role}, ${project.year}.`}
    image={ogImage}
>
    <!--
        `--header-h` keeps the pinned showcase tucked under the sticky header so
        the navigation stays visible for the whole scroll.
    -->
    <section
        class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white pt-20 pb-12 md:pt-4 md:pb-16 [--header-h:4rem] md:[--header-h:5.5rem]"
    >
        <!-- px-4 everywhere so the header's logo and CTA line up with the content -->
        <div class="px-4">
            <div
                class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10 lg:gap-16 xl:gap-24 items-start"
            >
                <!--
                    Left: scroll-driven showcase.
                    The track is stretched by ProjectGallery to `100svh + strip overflow`,
                    so the pinned strip travels sideways for exactly as long as it needs
                    before the page resumes scrolling.
                -->
                <div data-pin-track class="relative min-w-0">
                    <!-- No forced height on mobile: the block hugs the strip so the
                         project copy follows straight after instead of a blank screen. -->
                    <div
                        data-pin-sticky
                        class="sticky top-[var(--header-h)] flex flex-col justify-start pt-2 lg:min-h-[calc(100svh-var(--header-h))]"
                    >
                        <ProjectGallery
                            client:load
                            images={project.imageItems}
                        />
                    </div>
                </div>

                <!-- Right: Project details — pinned alongside so nothing shifts on desktop -->
                <div
                    class="flex flex-col gap-5 text-base leading-relaxed max-w-xl lg:sticky lg:top-[var(--header-h)] lg:min-h-[calc(100svh-var(--header-h))] lg:justify-start lg:pt-2"
                >
                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Name
                            </div>
                            <div class="text-palette-brightest-white">
                                {project.name}
                            </div>
                        </div>

                        {project.website && (
                            <div class="space-y-2">
                                <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                    Website
                                </div>
                                <a
                                    href={project.website}
                                    target="_blank"
                                    rel="noreferrer noopener"
                                    class="text-palette-brightest-white hover:underline underline-offset-4"
                                >
                                    {project.websiteLabel ??
                                        project.website
                                            .replace(/^https?:\/\//, "")
                                            .replace(/^www\./, "")
                                            .replace(/\/$/, "")}
                                </a>
                            </div>
                        )}
                    </div>

                    {project.outcome && (
                        <div class="space-y-2 border-l-2 border-palette-brightest-white/40 pl-4">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Outcome
                            </div>
                            <p class="text-palette-brightest-white">
                                {project.outcome}
                            </p>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            About
                        </div>
                        <p class="text-palette-brightest-white/80">
                            {project.about}
                        </p>
                    </div>

                    {project.tags.length > 0 && (
                        <div class="space-y-2">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Disciplines
                            </div>
                            <ul class="flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <li class="border border-palette-brightest-white/30 px-2.5 py-1 text-sm text-palette-brightest-white/80">
                                        {tag}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}

                    <div class="grid grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Client
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.client}
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Year
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.year}
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Role
                        </div>
                        <div class="text-palette-brightest-white/80">
                            {project.role}
                        </div>
                    </div>

                    {project.collaborators && (
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Collaborators
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.collaborators}
                            </div>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Programs
                        </div>
                        <ul class="space-y-1 text-palette-brightest-white/80">
                            {
                                project.programs.map((program) => (
                                    <li>{program}</li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- A quote from this very project, when one exists. Nothing renders otherwise. -->
    <Testimonials project={project.slug} limit={1} heading="What the client said" />

    <!--
        The warmest moment on the whole site is right here: someone has just
        finished reading the case. Previously the only thing on offer was
        "next_project", which walks them away from a decision.
    -->
    <CallToAction />

    <!-- Preview cards so you can see where you're going, not just that you can go. -->
    <nav
        class="w-full max-w-7xl mx-auto mb-20"
        aria-label="Other projects"
    >
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                {
                    previous ? (
                        <a
                            href={`/project/${previous.slug}`}
                            class="group flex items-center gap-4 border border-palette-brightest-white/20 p-3 transition-colors hover:border-palette-brightest-white/60"
                        >
                            <img
                                src={previous.thumbnailItem.src}
                                alt=""
                                width={previous.thumbnailItem.width}
                                height={previous.thumbnailItem.height}
                                loading="lazy"
                                decoding="async"
                                class="h-20 w-20 shrink-0 object-cover"
                            />
                            <span class="min-w-0">
                                <span class="block uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                    ← previous_project
                                </span>
                                <span class="mt-1 block truncate text-palette-brightest-white group-hover:underline underline-offset-4">
                                    {previous.name}
                                </span>
                                <span class="mt-0.5 block truncate text-sm text-palette-brightest-white/60">
                                    {previous.tagline}
                                </span>
                            </span>
                        </a>
                    ) : (
                        <span />
                    )
                }

                {
                    next && (
                        <a
                            href={`/project/${next.slug}`}
                            class="group flex items-center gap-4 border border-palette-brightest-white/20 p-3 text-right transition-colors hover:border-palette-brightest-white/60 md:col-start-2 md:flex-row-reverse"
                        >
                            <img
                                src={next.thumbnailItem.src}
                                alt=""
                                width={next.thumbnailItem.width}
                                height={next.thumbnailItem.height}
                                loading="lazy"
                                decoding="async"
                                class="h-20 w-20 shrink-0 object-cover"
                            />
                            <span class="min-w-0">
                                <span class="block uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                    next_project →
                                </span>
                                <span class="mt-1 block truncate text-palette-brightest-white group-hover:underline underline-offset-4">
                                    {next.name}
                                </span>
                                <span class="mt-0.5 block truncate text-sm text-palette-brightest-white/60">
                                    {next.tagline}
                                </span>
                            </span>
                        </a>
                    )
                }
            </div>
        </div>
    </nav>
</Layout>
