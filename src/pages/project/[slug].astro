---
import Contact from "../../components/Contact.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import Testimonials from "../../components/Testimonials.astro";
import Layout from "../../layouts/Layout.astro";
import { ONE_MORE_LINES } from "../../lib/one-more";
import {
	getOgImage,
	getProjects,
	parseCollaborators,
} from "../../lib/projects";

export async function getStaticPaths() {
	const projects = await getProjects();

	return projects.map((project, index) => ({
		params: { slug: project.slug },
		props: {
			project,
			index,
			// The project suggested at the end: the next one, and after the
			// last project the first one again, so every page has one.
			next: projects[(index + 1) % projects.length],
		},
	}));
}

const { project, next } = Astro.props;

const ogImage = await getOgImage(project.thumbnail);

// The images take the wider right column, so they are requested at about
// two thirds of the screen on desktop.
const imageSizes = "(max-width: 1023px) 100vw, 780px";
const collaborators = parseCollaborators(project.collaborators);
const websiteLabel =
	project.websiteLabel ??
	(project.website ?? "")
		.replace(/^https?:\/\//, "")
		.replace(/^www\./, "")
		.replace(/\/$/, "");
---

<Layout
    title={`${project.name} |`}
    description={`${project.tagline} ${project.outcome ?? ""}`.trim()}
    image={ogImage}
    imageAlt={`${project.name}, ${project.tagline}`}
>
    <!--
        Text on the left, pinned under the header so it reads from its first
        line; the images stack on the right, each one scaled to fit a single
        screen, so no picture ever needs two scrolls and the page shows the
        whole project in order. On a phone the text comes first.
    -->
    <section
        class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white pt-6 pb-6 md:pt-2 md:pb-8 [--header-h:4rem] md:[--header-h:5.5rem]"
    >
        <div class="px-4">
            <div
                class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] gap-10 lg:gap-12 xl:gap-16 items-start"
            >
                <!-- Left: project details -->
                <div
                    class="flex flex-col gap-6 text-base leading-relaxed max-w-xl lg:pt-2 lg:sticky lg:top-[var(--header-h)]"
                >
                    <!-- min-w-0: a long website name must wrap inside its cell
                         instead of widening the grid past a 320px screen. -->
                    <div class="grid grid-cols-2 gap-8 [&>*]:min-w-0">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Name
                            </div>
                            <!-- The page's h1: styled as the plain value it always was. -->
                            <h1 class="text-palette-brightest-white">
                                {project.name}
                            </h1>
                        </div>

                        {project.website && (
                            <div class="space-y-2">
                                <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                    Website
                                </div>
                                <a
                                    href={project.website}
                                    target="_blank"
                                    rel="noreferrer noopener"
                                    class="text-palette-brightest-white hover:underline underline-offset-4 [overflow-wrap:anywhere]"
                                >
                                    {/* <wbr> before each dot so a long domain breaks
                                        at ".com" rather than mid-word; anywhere-wrap
                                        is only the fallback for a single long word. */}
                                    {websiteLabel
                                        .split(".")
                                        .map((part, i) => (i > 0 ? <><wbr />.{part}</> : part))}
                                </a>
                            </div>
                        )}
                    </div>

                    {project.outcome && (
                        <div class="space-y-2 border-l-2 border-palette-brightest-white/40 pl-4">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Outcome
                            </div>
                            <p class="text-palette-brightest-white">
                                {project.outcome}
                            </p>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            About
                        </div>
                        <!-- Split on blank lines so a case study reads as prose,
                             not one intimidating slab of text. -->
                        <div class="space-y-4 text-palette-brightest-white/80">
                            {project.about
                                .split(/\n{2,}/)
                                .map((paragraph) => <p>{paragraph}</p>)}
                        </div>
                    </div>

                    {project.tags.length > 0 && (
                        <div class="space-y-2">
                            <div class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60">
                                Disciplines
                            </div>
                            <ul class="flex flex-wrap gap-2">
                                {project.tags.map((tag) => (
                                    <li class="bg-palette-brightest-white/15 px-2.5 py-1 text-sm text-palette-brightest-white/80">
                                        {tag}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}

                    <div class="grid grid-cols-2 gap-8 [&>*]:min-w-0">
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Client
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.client}
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Year
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {project.year}
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Role
                        </div>
                        <div class="text-palette-brightest-white/80">
                            {project.role}
                        </div>
                    </div>

                    {project.collaborators && (
                        <div class="space-y-2">
                            <div
                                class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                            >
                                Collaborators
                            </div>
                            <div class="text-palette-brightest-white/80">
                                {collaborators.map((person, i) => (
                                    <>
                                        {i > 0 && ", "}
                                        {person.url ? (
                                            <a
                                                href={person.url}
                                                target="_blank"
                                                rel="noreferrer noopener"
                                                class="hover:text-palette-brightest-white hover:underline underline-offset-4"
                                            >
                                                {person.name}
                                            </a>
                                        ) : (
                                            person.name
                                        )}
                                    </>
                                ))}
                            </div>
                        </div>
                    )}

                    <div class="space-y-2">
                        <div
                            class="uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60"
                        >
                            Programs
                        </div>
                        <ul class="space-y-1 text-palette-brightest-white/80">
                            {
                                project.programs.map((program) => (
                                    <li>{program}</li>
                                ))
                            }
                        </ul>
                    </div>
                </div>

                <!-- Right: every image, one under another, each fitting the screen -->
                <div class="project-images">
                    {project.imageItems.map((image, i) => (
                        <figure>
                            <img
                                src={image.src}
                                srcset={image.srcSet}
                                sizes={imageSizes}
                                alt={image.alt ?? image.title}
                                width={image.width}
                                height={image.height}
                                loading={i < 2 ? "eager" : "lazy"}
                                fetchpriority={i === 0 ? "high" : undefined}
                                decoding="async"
                            />
                            <figcaption>{image.title}</figcaption>
                        </figure>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!--
        A quote tied to this project, when one exists. The heading stays generic
        because the people quoted are a mix of clients, colleagues and mentors.
    -->
    <Testimonials project={project.slug} limit={1} class="section-gap" />


    <!--
        One more project, shown the same way as on the home page, with a
        question instead of a "next" label: an invitation to keep looking,
        not navigation.
    -->
    <section
        class="w-full max-w-7xl mx-auto px-4 mt-[var(--space-3xl)]"
        aria-labelledby="one-more-heading"
    >
        <!-- The first line; a script swaps it for the next one each time
             another project is opened in a row (src/lib/one-more.ts). -->
        <h2 id="one-more-heading" class="one-more text-lg md:text-xl text-palette-brightest-white">
            {ONE_MORE_LINES[0]}
        </h2>
        <ProjectGrid projects={[next]} priority={0} columns={2} class="mt-6" />
    </section>

    <!-- The same short ask as on the home page: one button to the contact page. -->
    <Contact options={false} />

</Layout>


<style>
    /* Past the tenth project in a row the question gets louder and won't sit still. */
    .one-more {
        transform-origin: left center;
    }

    :global(.one-more--crazy) {
        display: inline-block;
        font-size: clamp(1.5rem, 4vw, 2.75rem);
        line-height: 1.15;
        animation: one-more-wobble 1.6s ease-in-out infinite;
    }

    @keyframes one-more-wobble {
        0%, 100% { transform: rotate(0deg) scale(1); }
        20% { transform: rotate(-2deg) scale(1.03); }
        40% { transform: rotate(1.5deg) scale(0.99); }
        60% { transform: rotate(-1deg) scale(1.02); }
        80% { transform: rotate(1deg) scale(1); }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.one-more--crazy) {
            animation: none;
        }
    }

    .project-images {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-width: 0;
    }

    .project-images figure {
        margin: 0;
    }

    /* Never taller than the space under the header, minus the caption: the
       whole picture is always on screen at once. */
    .project-images img {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: calc(100svh - var(--header-h) - 2.5rem);
        object-fit: contain;
    }

    .project-images figcaption {
        margin-top: 0.25rem;
        font-size: 0.8rem;
        color: var(--color-palette-brightest-white);
    }
</style>
