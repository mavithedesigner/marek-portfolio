---
import ProjectGrid from "../components/ProjectGrid.astro";
import Layout from "../layouts/Layout.astro";
import { getProjectTags, getProjects } from "../lib/projects";

const projects = await getProjects();
const tags = await getProjectTags();
---

<Layout
  title="Archive |"
  description="Selected work by Marek Vicáň: visual identity, UX/UI, web and art direction for brands, products and local initiatives."
>
  <section class="w-full bg-background text-palette-brightest-white py-[var(--section-gap)]">
    <div class="max-w-7xl mx-auto">
      <!-- For search engines and screen readers; the grid introduces itself. -->
      <h1 class="sr-only">Archive</h1>
      <!--
        Twelve projects is enough that someone looking for one discipline has to
        wade through the rest. Filtering is client-side: every project stays in
        the HTML, so the page still works without JavaScript.
      -->
      <div class="px-4">
        <div
          class="flex flex-wrap items-center gap-2"
          role="group"
          aria-label="Filter projects by discipline"
          data-archive-filters
        >
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filter-chip"
          >
            All
          </button>
          {tags.map((tag) => (
            <button
              type="button"
              data-filter={tag}
              aria-pressed="false"
              class="filter-chip"
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

    </div>
    <div class="w-full max-w-7xl mx-auto px-4 mt-8">
      <ProjectGrid projects={projects} data-archive-grid />
    </div>
    <div class="max-w-7xl mx-auto">
      <p class="px-4 mt-10 text-secondary-foreground" data-archive-empty hidden>
        Nothing in this discipline yet.
      </p>
    </div>
  </section>
</Layout>

<style>
	/* Smooth image transitions */
	img {
		transition: opacity 0.2s ease-in-out;
		will-change: contents;
	}

	/* Prevent scroll jumping and touch behaviors */
	img[tabindex] {
		user-select: none;
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
		touch-action: manipulation;
	}

	/* Same chip as Contact in the navbar: on this site that shape means clickable. */
	.filter-chip {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		padding: 0.375rem 0.75rem;
		font-size: 0.8rem;
		color: var(--color-palette-brightest-white);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	/* Fingers need a bigger target than the cursor does; the desktop chip is unchanged. */
	@media (pointer: coarse) {
		.filter-chip {
			min-height: 2.5rem;
		}
	}

	.filter-chip:hover {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.filter-chip[aria-pressed="true"] {
		background: var(--color-palette-brightest-white);
		color: var(--color-background);
	}

</style>

<script>
	function bindArchiveFilters() {
		const filterBar = document.querySelector<HTMLElement>("[data-archive-filters]");
		const grid = document.querySelector<HTMLElement>("[data-archive-grid]");
		const empty = document.querySelector<HTMLElement>("[data-archive-empty]");

		if (!filterBar || !grid || filterBar.dataset.bound === "true") return;
		filterBar.dataset.bound = "true";

		const buttons = [...filterBar.querySelectorAll<HTMLButtonElement>("[data-filter]")];
		const cards = [...grid.querySelectorAll<HTMLElement>(".project-card")];

		function apply(filter: string) {
			/*
			 * Hiding cards makes the document shorter. The browser clamps the real
			 * scroll immediately, but Lenis still holds the old value and eases back
			 * to the new limit on its next frame, which reads as the page scrolling
			 * by itself. So: freeze Lenis, change the DOM, re-measure, put the scroll
			 * exactly where it was, then let Lenis run again.
			 */
			const lenis = (window as any).__lenis;
			const root = document.documentElement;
			const before = window.scrollY;

			// With reduced motion Lenis stops marking the root, which re-enables the
			// CSS smooth-scroll fallback. Switch it off for the length of the swap.
			root.style.scrollBehavior = "auto";
			lenis?.stop?.();

			let visible = 0;

			for (const card of cards) {
				const tags = (card.dataset.tags ?? "").split("|").filter(Boolean);
				const show = filter === "all" || tags.includes(filter);
				card.hidden = !show;
				if (show) visible++;
			}

			for (const button of buttons) {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.filter === filter),
				);
			}

			if (empty) empty.hidden = visible > 0;
			grid.dispatchEvent(new CustomEvent("masonry:layout"));

			requestAnimationFrame(() => {
				lenis?.resize?.();

				const max = Math.max(
					0,
					document.documentElement.scrollHeight - window.innerHeight,
				);
				const target = Math.min(before, max);

				// Native first, so the browser and Lenis agree before Lenis resumes.
				window.scrollTo(0, target);
				lenis?.scrollTo?.(target, { immediate: true, force: true });
				lenis?.start?.();

				requestAnimationFrame(() => {
					root.style.scrollBehavior = "";
				});
			});
		}

		for (const button of buttons) {
			button.addEventListener("click", (event) => {
				// Stop the browser from scrolling the freshly focused button into view.
				event.preventDefault();
				apply(button.dataset.filter ?? "all");
			});
		}
	}

	bindArchiveFilters();
	document.addEventListener("astro:after-swap", bindArchiveFilters);
</script>
