---
import { getImage } from "astro:assets";
import CycleImage from "../components/CycleImage";
import Experience from "../components/Experience.astro";
import Layout from "../layouts/Layout.astro";

// Import images directly
import brokenMirror from "../assets/archive/brokenmirror.png";
import duo from "../assets/archive/duo.png";
import marek1 from "../assets/archive/marek1.png";
import portrait from "../assets/archive/portrait.png";

// Optimize images for different sizes with responsive variants
const optimizeImage = async (src: ImageMetadata) => {
	const [small, medium, large] = await Promise.all([
		getImage({ src, width: 400, format: "webp", quality: 85 }),
		getImage({ src, width: 800, format: "webp", quality: 85 }),
		getImage({ src, width: 1200, format: "webp", quality: 85 }),
	]);
	return { small, medium, large };
};

const title = "About";

const [
	brokenmirrorOptimized,
	portraitOptimized,
	duoOptimized,
	marek1Optimized,
] = await Promise.all([
	optimizeImage(brokenMirror),
	optimizeImage(portrait),
	optimizeImage(duo),
	optimizeImage(marek1),
]);

// Client-usable list of optimized images with responsive sources
const cycleImages = [
	{
		title: "gallery.png",
		src: brokenmirrorOptimized.medium.src,
		srcSet: `${brokenmirrorOptimized.small.src} 400w, ${brokenmirrorOptimized.medium.src} 800w, ${brokenmirrorOptimized.large.src} 1200w`,
		sizes: "(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px",
		width: brokenmirrorOptimized.medium.attributes.width,
		height: brokenmirrorOptimized.medium.attributes.height,
	},
	{
		title: "portrait.png",
		src: portraitOptimized.medium.src,
		srcSet: `${portraitOptimized.small.src} 400w, ${portraitOptimized.medium.src} 800w, ${portraitOptimized.large.src} 1200w`,
		sizes: "(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px",
		width: portraitOptimized.medium.attributes.width,
		height: portraitOptimized.medium.attributes.height,
	},
	{
		title: "duo.png",
		src: duoOptimized.medium.src,
		srcSet: `${duoOptimized.small.src} 400w, ${duoOptimized.medium.src} 800w, ${duoOptimized.large.src} 1200w`,
		sizes: "(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px",
		width: duoOptimized.medium.attributes.width,
		height: duoOptimized.medium.attributes.height,
	},
	{
		title: "marek1.png",
		src: marek1Optimized.medium.src,
		srcSet: `${marek1Optimized.small.src} 400w, ${marek1Optimized.medium.src} 800w, ${marek1Optimized.large.src} 1200w`,
		sizes: "(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px",
		width: marek1Optimized.medium.attributes.width,
		height: marek1Optimized.medium.attributes.height,
	},
];
---

<Layout title="About |">
	<div class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white py-16 min-h-screen">
		<div class="container mx-auto px-4">
		<!-- Hero Section -->
		<div class="mb-32">
			<!-- Mobile: Table-like two-column layout, Desktop: 3-column grid layout -->
			<div class="max-w-2xl mx-auto lg:max-w-none">
			<!-- Mobile: Single two-column grid for all sections -->
			<!-- Desktop: Three columns with stacked content -->
			<div class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-8 lg:grid-cols-3 lg:gap-x-16 lg:gap-y-0">
				<!-- About Column -->
				<h1 class="text-base font-mono text-secondary-foreground whitespace-nowrap self-start lg:hidden">About</h1>
				<div class="space-y-6 lg:col-span-1">
					<h1 class="hidden lg:block text-base font-mono text-secondary-foreground mb-2">About</h1>
					<p class="leading-relaxed">
						As a multidisciplinary designer, I focus on various aspects of visual creation, from graphic design to digital and interactive projects.
					</p>
					<p class="leading-relaxed">
						I create visual identities, website design, applications, and marketing materials, striving to combine creative solutions that are functional, aesthetically pleasing, and inspiring.
					</p>
					<p class="leading-relaxed">
						My approach allows me to integrate different design disciplines, ensuring my projects are both effective and visually impactful.
					</p>
				</div>

				<!-- Capabilities & Programs Column -->
				<h2 class="text-base font-mono text-secondary-foreground whitespace-nowrap self-start lg:hidden">Capabilities</h2>
				<div class="lg:col-span-1">
					<h2 class="hidden lg:block text-base font-mono text-secondary-foreground mb-2">Capabilities</h2>
					<ul>
						<li>Visual communication</li>
						<li>Digital design</li>
						<li>User-centered design</li>
						<li>Collaborative creativity</li>
						<li>Project management</li>
						<li>Cross-disciplinary approach</li>
					</ul>

					<h2 class="text-base font-mono text-secondary-foreground mt-12 mb-2">Programs</h2>
					<ul>
						<li>Figma</li>
						<li>Adobe Illustrator</li>
						<li>Adobe Photoshop</li>
						<li>Adobe Premiere Pro</li>
						<li>Framer</li>
						<li>Notion</li>
					</ul>
				</div>

				<!-- Location & Contact Column -->
				<h2 class="text-base font-mono text-secondary-foreground whitespace-nowrap self-start lg:hidden">Location</h2>
				<div class="lg:col-span-1">
					<h2 class="hidden lg:block text-base font-mono text-secondary-foreground mb-2">Location</h2>
					<p class="mb-12">Based in Bratislava, Slovakia</p>

					<h2 class="text-base font-mono text-secondary-foreground mb-2">Contact</h2>
					<a href="mailto:contact@marekvician.com" class="hover:underline">
						contact@vican.design
					</a>
				</div>
			</div>
			</div>
		</div>

			<!-- Image Section -->
			<div class="flex justify-center mb-16">
				<div class="w-full max-w-md">
					<CycleImage 
						client:load 
						images={cycleImages}
						startIndex={0}
						wrapperClassName="relative overflow-hidden"
						className="w-full h-auto select-none"
						showCounter={true}
					/>
				</div>
			</div>
		</div>
	</div>

	<!-- Experience Section -->
	<Experience showMore={false} />
</Layout>
