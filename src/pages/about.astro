---
import { getImage } from "astro:assets";
import Experience from "../components/Experience.astro";
import Layout from "../layouts/Layout.astro";
import ProjectGallery from "../components/ProjectGallery";

// Import images directly
import marek_designer from "../assets/marek_designer.png";
import brokenMirror from "../assets/archive/brokenmirror.png";
import marek_photography from "../assets/archive/marek_photography.png";
import portrait from "../assets/archive/portrait.png";

// Optimize images for different sizes with responsive variants
const optimizeImage = async (src: ImageMetadata) => {
	const [small, medium, large] = await Promise.all([
		getImage({ src, width: 400, format: "webp", quality: 85 }),
		getImage({ src, width: 800, format: "webp", quality: 85 }),
		getImage({ src, width: 1200, format: "webp", quality: 85 }),
	]);
	return { small, medium, large };
};

const galleryImages = await Promise.all(
	[
		{ title: "marek_photography.png", src: marek_photography },
		{ title: "marek_designer.png", src: marek_designer },
		{ title: "gallery.png", src: brokenMirror },
		{ title: "portrait.png", src: portrait },
	].map(async ({ title, src }) => {
		const { small, medium, large } = await optimizeImage(src);
		return {
			title,
			src: medium.src,
			srcSet: `${small.src} 400w, ${medium.src} 800w, ${large.src} 1200w`,
			sizes: "(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px",
			width: medium.attributes.width,
			height: medium.attributes.height,
		};
	}),
);

// Content lives here once, so the mobile and desktop layouts can't drift apart.
const aboutParagraphs = [
	"I’m Marek, a curious multidisciplinary designer from Orava, Slovakia, working across visual identity, web design, and digital products.",
	"I like to build projects as a “founder of myself”, but only around ideas that serve people and create a more creative world, from digital services to local initiatives and educational platforms.",
	"My goal is to create a creative world around me and stand behind projects whose purpose has a real impact, whether they are digital services, local initiatives, or educational platforms.",
];

const howIWork = [
	"Research & analysis first",
	"Understanding the client deeply",
	"Long-term thinking",
	"Clear and thoughtful design",
	"Founder mindset",
];

// What a client can actually order. Tools moved below, where they belong —
// nobody hires a designer because they own Illustrator.
const services = [
	"Visual identity & naming",
	"Web design & art direction",
	"Product and UX/UI design",
	"Content and campaign visuals",
];

const tools = [
	"Figma",
	"Adobe Illustrator",
	"Adobe Photoshop",
	"Adobe Premiere Pro",
	"Framer",
	"Notion",
	"Claude",
	"Perplexity",
	"GitHub",
	"Vercel",
];

const location = "Based in Aarhus, Denmark";
const email = "contact@vican.design";

const labelClass = "text-base font-mono text-secondary-foreground";
---

<Layout
	title="About |"
	description="Marek Vicáň, multidisciplinary designer from Orava, based in Bratislava. Visual identity, web design and digital products."
>
	<!-- Mobile mirrors the project detail: showcase first, copy underneath -->
	<div class="flex flex-col">
	<div class="order-2 lg:order-1 w-full max-w-7xl mx-auto bg-background text-palette-brightest-white py-[var(--section-gap)]">
		<div class="container mx-auto px-4">
			<!-- Mobile: every section gets its own label column, including Programs and Contact -->
			<div class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-10 lg:hidden">
				<h1 class={`${labelClass} whitespace-nowrap self-start`}>About</h1>
				<div class="space-y-6">
					{aboutParagraphs.map((text) => <p class="leading-relaxed">{text}</p>)}
				</div>

				<h2 class={`${labelClass} whitespace-nowrap self-start`}>How I work</h2>
				<ul>
					{howIWork.map((item) => <li>{item}</li>)}
				</ul>

				<h2 class={`${labelClass} whitespace-nowrap self-start`}>What I do</h2>
				<ul>
					{services.map((item) => <li>{item}</li>)}
				</ul>

				<h2 class={`${labelClass} whitespace-nowrap self-start`}>Tools</h2>
				<p class="text-palette-brightest-white/60">{tools.join(", ")}</p>

				<h2 class={`${labelClass} whitespace-nowrap self-start`}>Location</h2>
				<p>{location}</p>

				<h2 class={`${labelClass} whitespace-nowrap self-start`}>Contact</h2>
				<a href={`mailto:${email}`} class="hover:underline justify-self-start">{email}</a>
			</div>

			<!-- Desktop: three columns, secondary sections stacked under their siblings -->
			<div class="hidden lg:grid lg:grid-cols-3 lg:gap-x-16 lg:items-start">
				<div class="space-y-6">
					<h1 class={`${labelClass} mb-2`}>About</h1>
					{aboutParagraphs.map((text) => <p class="leading-relaxed">{text}</p>)}
				</div>

				<div>
					<h2 class={`${labelClass} mb-2`}>How I work</h2>
					<ul>
						{howIWork.map((item) => <li>{item}</li>)}
					</ul>

					<h2 class={`${labelClass} mt-12 mb-2`}>What I do</h2>
					<ul>
						{services.map((item) => <li>{item}</li>)}
					</ul>

					<h2 class={`${labelClass} mt-12 mb-2`}>Tools</h2>
					<p class="text-palette-brightest-white/60">{tools.join(", ")}</p>
				</div>

				<div>
					<h2 class={`${labelClass} mb-2`}>Location</h2>
					<p class="mb-12">{location}</p>

					<h2 class={`${labelClass} mb-2`}>Contact</h2>
					<a href={`mailto:${email}`} class="hover:underline">{email}</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Same scroll-driven showcase as the project detail pages -->
	<div class="order-1 lg:order-2 w-full max-w-7xl mx-auto [--header-h:4rem] md:[--header-h:5.5rem]">
		<div class="container mx-auto px-4">
			<div data-pin-track class="relative min-w-0">
				<div
					data-pin-sticky
					class="sticky top-[var(--header-h)] flex flex-col justify-start pt-2 lg:min-h-[calc(100svh-var(--header-h))]"
				>
					<ProjectGallery client:load images={galleryImages} />
				</div>
			</div>
		</div>
	</div>

	</div>

	<!-- Experience Section -->
	<Experience showMore={false} />
</Layout>
