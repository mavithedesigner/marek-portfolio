---
import ArchivePreview from "../components/ArchivePreview.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Logos from "../components/Logos.astro";
import Testimonials from "../components/Testimonials.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import WritingHeading from "../components/WritingHeading.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="relative flex flex-col items-center justify-center min-h-[calc(100vh-5rem)]">
		<WritingHeading />
		<div class="absolute bottom-8 left-0 right-0 flex justify-center">
			<ThemeToggle />
		</div>
	</div>
	<ArchivePreview />
	<Logos />
	<!-- Proof from other people, right after the work. Hidden until quotes exist. -->
	<!-- Its own breathing room on both sides, so the quotes don't bleed into
	     Experience. With no quotes the section vanishes and spacing is unchanged. -->
	<Testimonials class="section-gap section-gap-b" />
	<Experience topMargin={false} />
	<Contact />
</Layout>
