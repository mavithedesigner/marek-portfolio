---
import { getImage } from "astro:assets";
import { ViewTransitions } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import ogSource from "../assets/archive/aac_logo_3d.png";
import CustomCursor from "../components/CustomCursor";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ImageCounter from "../components/ImageCounter";
import MobileHeader from "../components/MobileHeader";
import PageLoader from "../components/PageLoader.astro";
import { SHOW_THOUGHTS } from "../lib/features";
import { PERSON_ID, person, toJsonLd } from "../lib/thoughts";

// 1200×630 is what LinkedIn, WhatsApp and Slack expect from a link preview.
const ogFallback = await getImage({
	src: ogSource,
	width: 1200,
	height: 630,
	fit: "cover",
	format: "jpg",
});

const defaultDescription =
	"Marek is a designer based in Bratislava, Slovakia. He creates visual identities, website design, applications, and marketing materials, striving to combine creative solutions that are functional, aesthetically pleasing, and inspiring.";

const {
	title,
	// Each page can describe itself; search results and link previews stop
	// looking identical across the whole site.
	description = defaultDescription,
	// Relative path to the preview image; falls back to the shared one.
	image = ogFallback.src,
	// Pixel size of `image`, so platforms can lay out the preview before it
	// downloads. Only known for the fallback unless a page passes its own.
	imageWidth = image === ogFallback.src ? 1200 : undefined,
	imageHeight = image === ogFallback.src ? 630 : undefined,
	imageAlt,
	// Posts are "article": LinkedIn and Facebook show the date and author, and
	// search engines read article:published_time as the publication date.
	type = "website",
	// { published: Date, modified?: Date, tags?: string[] }, for type "article".
	article,
	// Structured data for this page (schema.org), one object or a list.
	jsonLd,
	...props
} = Astro.props;

// Absolute URLs — social platforms reject relative ones.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
const fullTitle = `${title ?? ""} Marek Vican`.trim();

const site = Astro.site ?? Astro.url;

/*
 * The home page says who runs the site. Search engines use this for the name
 * shown above results and for the knowledge panel, and every post points back
 * to the same person through PERSON_ID, so the writing and the portfolio are
 * understood as one author.
 */
const homeJsonLd =
	Astro.url.pathname === "/"
		? [
				{
					"@context": "https://schema.org",
					"@type": "WebSite",
					"@id": new URL("/#website", site).href,
					url: new URL("/", site).href,
					name: "Marek Vicáň",
					inLanguage: "en",
					publisher: { "@id": PERSON_ID },
				},
				{ "@context": "https://schema.org", ...person },
			]
		: [];
const structuredData = [...homeJsonLd, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			// Applied before first paint so switching themes never flashes.
			// View transitions replace <html>, so the theme has to be re-applied
			// after every swap, otherwise navigating resets the page.
			//
			// Dark is the default and carries no attribute: only an explicit
			// choice of light mode is ever written onto <html>. Someone arriving
			// for the first time always lands on the dark site, whatever their
			// operating system prefers.
			(function () {
				// Bumping this key retires every previously saved choice, so the
				// site falls back to its dark default for everyone once.
				var THEME_KEY = "theme-2";

				function applyStoredTheme() {
					try {
						if (localStorage.getItem(THEME_KEY) === "light") {
							document.documentElement.dataset.theme = "light";
						} else {
							delete document.documentElement.dataset.theme;
						}
					} catch (_) {
						/* private mode, fall back to dark */
					}
				}

				applyStoredTheme();

				if (!window.__themeSwapBound) {
					window.__themeSwapBound = true;
					document.addEventListener("astro:after-swap", applyStoredTheme);
				}
			})();
		</script>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />

		<!-- Link previews: without these a shared URL shows as bare text. -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Marek Vican" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={ogImage.href} />
		{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
		{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
		{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		{
			article && (
				<>
					<meta property="article:published_time" content={article.published.toISOString()} />
					{article.modified && (
						<meta property="article:modified_time" content={article.modified.toISOString()} />
					)}
					<meta property="article:author" content={new URL("/about/", site).href} />
					{article.tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
				</>
			)
		}
		<meta property="og:locale" content="en_GB" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage.href} />
		{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

		<!-- Lets feed readers and browser extensions find the feed from any page. -->
		{
			SHOW_THOUGHTS && (
				<link
					rel="alternate"
					type="application/rss+xml"
					title="Marek Vicáň — Thoughts"
					href={new URL("/rss.xml", site).href}
				/>
			)
		}

		{
			structuredData.map((data) => (
				<script is:inline type="application/ld+json" set:html={toJsonLd(data)} />
			))
		}

		<ViewTransitions />

		<!--
			Vercel Web Analytics. The official component rather than a bare script
			tag, because this site navigates with view transitions: the component
			registers each client-side route change, a plain script only counts the
			first page load. No cookies, no consent banner.
		-->
		<Analytics />
	</head>
	<body>
		<div class="noise-overlay" aria-hidden="true"></div>
		<!--
			The cursor and the image counter both follow the mouse, so on touch
			screens they render nothing. client:media skips downloading and
			hydrating them there entirely.
		-->
		<CustomCursor client:media="(hover: hover)" transition:persist />
		<ImageCounter client:media="(hover: hover)" transition:persist />
		<PageLoader transition:persist />
		<Header />
		<!-- client:load: the menu button has to answer the very first tap. -->
		<MobileHeader client:load />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
		<script>
			import Lenis from "@studio-freight/lenis";

			/*
			 * Smooth scrolling, set up exactly once per visit.
			 *
			 * This script runs again on every view-transition navigation. Without the
			 * guard below, each page visited created ANOTHER Lenis instance with
			 * ANOTHER animation loop, and every one of them kept writing the scroll
			 * position every frame. The result was a page that drifted on its own
			 * after a few clicks, and that never started at the top. One instance,
			 * one loop, for the life of the tab.
			 */
			const w = window as any;

			if (!w.__lenis) {
				const prefersReducedMotion = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;

				const lenis = new Lenis({
					duration: prefersReducedMotion ? 0 : 1,
					smoothWheel: !prefersReducedMotion,
				});

				// Exposed so the project gallery can keep page scroll and the
				// horizontal strip in sync when the strip is swiped directly.
				w.__lenis = lenis;

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}

				if (!prefersReducedMotion) {
					requestAnimationFrame(raf);
				}

				// The browser restoring a scroll position fights the rule below, so it
				// is switched off for the whole site, not just the project pages.
				if ("scrollRestoration" in history) {
					history.scrollRestoration = "manual";
				}

				/*
				 * Every navigation starts at the top. Lenis keeps its own idea of the
				 * scroll position across a view transition, so it has to be told, not
				 * just the window.
				 */
				document.addEventListener("astro:after-swap", () => {
					window.scrollTo(0, 0);
					lenis.resize();
					lenis.scrollTo(0, { immediate: true, force: true });
				});
			}
		</script>
	</body>
</html>