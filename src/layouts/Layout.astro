---
import { ViewTransitions } from "astro:transitions";
import { getImage } from "astro:assets";
import "../styles/global.css";
import ogSource from "../assets/archive/aac_logo_3d.png";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MobileHeader from "../components/MobileHeader";
import CustomCursor from "../components/CustomCursor";
import ImageCounter from "../components/ImageCounter";

// 1200×630 is what LinkedIn, WhatsApp and Slack expect from a link preview.
const ogFallback = await getImage({
	src: ogSource,
	width: 1200,
	height: 630,
	fit: "cover",
	format: "jpg",
});

const defaultDescription =
	"Marek is a designer based in Bratislava, Slovakia. He creates visual identities, website design, applications, and marketing materials, striving to combine creative solutions that are functional, aesthetically pleasing, and inspiring.";

const {
	title,
	// Each page can describe itself; search results and link previews stop
	// looking identical across the whole site.
	description = defaultDescription,
	// Relative path to the preview image; falls back to the shared one.
	image = ogFallback.src,
	...props
} = Astro.props;

// Absolute URLs — social platforms reject relative ones.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
const fullTitle = `${title ?? ""} Marek Vican`.trim();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			// Applied before first paint so switching themes never flashes.
			// View transitions replace <html>, so the theme has to be re-applied
			// after every swap — otherwise navigating resets the page to dark.
			(function () {
				function applyStoredTheme() {
					try {
						const stored = localStorage.getItem("theme");
						if (stored === "light" || stored === "dark") {
							document.documentElement.dataset.theme = stored;
						} else {
							delete document.documentElement.dataset.theme;
						}
					} catch (_) {
						/* private mode — fall back to dark */
					}
				}

				applyStoredTheme();

				if (!window.__themeSwapBound) {
					window.__themeSwapBound = true;
					document.addEventListener("astro:after-swap", applyStoredTheme);
				}
			})();
		</script>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />

		<!-- Link previews: without these a shared URL shows as bare text. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Marek Vican" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={ogImage.href} />
		<meta property="og:locale" content="en_GB" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage.href} />

		<ViewTransitions />

		<!--
			Vercel Web Analytics. Needs to be switched on once in the Vercel
			dashboard (Project → Analytics); until then the script 404s harmlessly.
			No cookies, no consent banner.
		-->
		<script is:inline defer src="/_vercel/insights/script.js"></script>
	</head>
	<body>
		<div class="noise-overlay" aria-hidden="true"></div>
		<CustomCursor client:load transition:persist />
		<ImageCounter client:load transition:persist />
		<Header />
		<MobileHeader client:load />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
		<script>
			import Lenis from "@studio-freight/lenis";

			const prefersReducedMotion = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;

			const lenis = new Lenis({
				duration: prefersReducedMotion ? 0 : 1,
				smoothWheel: !prefersReducedMotion,
			});

			// Exposed so the project gallery can keep page scroll and the
			// horizontal strip in sync when the strip is swiped directly.
			(window as any).__lenis = lenis;

			function raf(time: number) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}

			if (!prefersReducedMotion) {
				requestAnimationFrame(raf);
			}
		</script>
	</body>
</html>