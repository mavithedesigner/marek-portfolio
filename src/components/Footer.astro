---
import { SHOW_THOUGHTS } from "../lib/features";
import ThemeToggle from "./ThemeToggle.astro";

const leftLinks = [
	{
		href: "https://www.artisticareaclub.com/",
		text: "Artistic Area Club",
	},
];

const pages = [
	{ href: "/archive/", text: "Archive" },
	...(SHOW_THOUGHTS ? [{ href: "/thoughts/", text: "Thoughts" }] : []),
	{ href: "/about/", text: "About" },
	{ href: "/contact/", text: "Contact" },
];


// LinkedIn first: for a prospective client it's the most natural first contact,
// not the fourth item under Pinterest.
const socials = [
	{ href: "https://www.linkedin.com/in/vicandesign/", text: "Linkedin" },
	{ href: "https://www.instagram.com/vican.design.aac/", text: "Instagram" },
	{ href: "https://www.behance.net/marekvic", text: "Behance" },
	{ href: "https://sk.pinterest.com/mavithedesigner/", text: "Pinterest" },
];

const email = "contact@vican.design";
const year = new Date().getFullYear();

const labelClass = "text-secondary-foreground mb-1";
---

<footer class="site-footer w-full section-gap">
	<div class="w-full max-w-7xl mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pt-[var(--space-xl)] pb-8">
			<ul>
				{leftLinks.map((l) => (
					<li><a href={l.href} class="hover:underline" target="_blank" rel="noreferrer noopener">{l.text}</a></li>
				))}
			</ul>

			<div>
				<p class={labelClass}>Pages</p>
				<ul>
					{pages.map((l) => (
						<li><a href={l.href} class="hover:underline">{l.text}</a></li>
					))}
				</ul>
			</div>

			<div>
				<p class={labelClass}>Socials</p>
				<ul>
					{socials.map((l) => (
						<li><a href={l.href} class="hover:underline" target="_blank" rel="noreferrer noopener">{l.text}</a></li>
					))}
				</ul>
			</div>

			<div>
				<p class={labelClass}>Get in touch</p>
				<a href={`mailto:${email}`} class="hover:underline">{email}</a>
				<a
					href="https://cal.com/vican.design/15min"
					target="_blank"
					rel="noreferrer noopener"
					class="mt-1 block hover:underline"
				>
					Book a 15-min call
				</a>
			</div>
		</div>

		<div class="h-px bg-white/10"></div>
		<!--
			Three slots so the copyright stays in the middle whatever sits beside it:
			the RSS link (once Thoughts is public) on the left, the theme switch on
			the right. On a phone they stack, centred.
		-->
		<div
			class="flex flex-col items-center gap-3 pt-4 pb-12 text-palette-brightest-white sm:grid sm:grid-cols-[1fr_auto_1fr] sm:gap-6"
		>
			<!-- A feed, not a way to contact me, so it belongs down here. Without it
			     the slot stays as an empty spacer on wide screens. -->
			{SHOW_THOUGHTS ? (
				<div class="order-3 flex gap-5 sm:order-none sm:justify-self-start">
					<a href="/rss.xml" class="text-secondary-foreground hover:underline">RSS feed</a>
					<a href="/privacy/" class="text-secondary-foreground hover:underline">Privacy</a>
				</div>
			) : (
				<div class="order-3 sm:order-none sm:justify-self-start">
					<a href="/privacy/" class="text-secondary-foreground hover:underline">Privacy</a>
				</div>
			)}
			<p class="order-2 text-center sm:order-none">Marek Vicáň © {year} All Rights Reserved</p>
			<div class="order-1 sm:order-none sm:justify-self-end">
				<ThemeToggle />
			</div>
		</div>
	</div>
</footer>

<style>
	/*
	 * The footer sits on its own surface, a few percent lighter than the page,
	 * with a hairline on top. Without it the links at the end of a long page read
	 * as more content; with it they read as the end of the page.
	 * Built from the theme variables, so it flips with light mode on its own.
	 */
	.site-footer {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 5%, var(--color-background));
		border-top: 1px solid color-mix(in srgb, var(--color-palette-brightest-white) 12%, transparent);
	}

	/*
	 * Links are one text line tall, which is plenty for a cursor but too small
	 * and too tightly stacked for a thumb. Touch screens get 44px rows; desktop
	 * keeps the compact list.
	 */
	@media (pointer: coarse) {
		.site-footer a {
			display: flex;
			align-items: center;
			width: fit-content;
			min-height: 2.75rem;
		}
	}
</style>
