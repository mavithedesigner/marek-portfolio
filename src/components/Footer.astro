---
const leftLinks = [
	{
		href: "https://www.artisticareaclub.com/",
		text: "Artistic Area Club",
	},
];

const pages = [
	{ href: "/archive", text: "Archive" },
	{ href: "/about", text: "About" },
	{ href: "/contact", text: "Contact" },
];

// Lives in /public so the file is served as-is, no build step involved.
const cv = "/cv/Marek-Vican-CV.pdf";

// LinkedIn first: for a prospective client it's the most natural first contact,
// not the fourth item under Pinterest.
const socials = [
	{ href: "https://www.linkedin.com/in/vicandesign/", text: "Linkedin" },
	{ href: "https://www.instagram.com/vican.design.aac/", text: "Instagram" },
	{ href: "https://www.behance.net/marekvic", text: "Behance" },
	{ href: "https://sk.pinterest.com/mavithedesigner/", text: "Pinterest" },
];

const email = "contact@vican.design";
const year = new Date().getFullYear();

const labelClass = "text-secondary-foreground mb-1";
---

<footer class="w-full section-gap">
	<div class="w-full max-w-7xl mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-8 py-8">
			<ul>
				{leftLinks.map((l) => (
					<li><a href={l.href} class="hover:underline" target="_blank" rel="noreferrer noopener">{l.text}</a></li>
				))}
			</ul>

			<div>
				<p class={labelClass}>Pages</p>
				<ul>
					{pages.map((l) => (
						<li><a href={l.href} class="hover:underline">{l.text}</a></li>
					))}
				</ul>
			</div>

			<div>
				<p class={labelClass}>Socials</p>
				<ul>
					{socials.map((l) => (
						<li><a href={l.href} class="hover:underline" target="_blank" rel="noreferrer noopener">{l.text}</a></li>
					))}
				</ul>
			</div>

			<div>
				<p class={labelClass}>Get in touch</p>
				<a href={`mailto:${email}`} class="hover:underline">{email}</a>
				<a
					href="https://cal.com/vican.design/15min"
					target="_blank"
					rel="noreferrer noopener"
					class="mt-1 block hover:underline"
				>
					Book a 15-min call
				</a>
				<a href={cv} download class="mt-1 block hover:underline">
					Download CV (PDF)
				</a>
			</div>
		</div>

		<div class="h-px bg-white/10"></div>
		<p class="text-center text-palette-brightest-white pt-4 pb-12">ARTISTICAREACLUB © {year} All Rights Reserved</p>
	</div>
</footer>
