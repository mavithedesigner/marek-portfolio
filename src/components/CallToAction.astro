---
/**
 * The single place where "get in touch" is defined.
 *
 * Three equal routes, because people arrive at different stages:
 *  - decided          -> email
 *  - interested, unsure how to brief -> book a call
 *  - still checking you out          -> LinkedIn
 *
 * Used at the end of every project, on the contact page and on the home page,
 * so the offer is identical wherever someone stops reading.
 */
interface Props {
	heading?: string;
	intro?: string;
	/** `full` = page section with its own spacing. `inline` = dropped inside another layout. */
	variant?: "full" | "inline";
	class?: string;
}

const {
	heading = "Let’s talk",
	intro = "Working on something similar? Send me a few lines, or grab a slot and we’ll talk it through.",
	variant = "full",
	class: className = "",
} = Astro.props;

const email = "contact@vican.design";
const mailto = `mailto:${email}?subject=${encodeURIComponent("Project enquiry")}`;
const calLink = "https://cal.com/vican.design/15min";
const linkedin = "https://www.linkedin.com/in/vicandesign/";

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
const tileClass =
	"group flex h-full flex-col justify-between gap-6 border border-palette-brightest-white/20 p-5 transition-colors hover:border-palette-brightest-white/60 focus-within:border-palette-brightest-white/60";
const actionClass =
	"inline-flex items-center gap-2 text-palette-brightest-white underline-offset-4 group-hover:underline";
---

<section
	class={`${variant === "full" ? "w-full max-w-7xl mx-auto mt-32 mb-16" : ""} ${className}`}
	aria-labelledby="cta-heading"
>
	<div class={variant === "full" ? "container mx-auto px-4" : ""}>
		<h2 id="cta-heading" class={labelClass}>{heading}</h2>
		<p class="mt-3 max-w-xl text-palette-brightest-white/80">{intro}</p>

		<div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
			<!-- 1. Email — for people who already know what they want -->
			<div class={tileClass}>
				<div>
					<div class="text-palette-brightest-white">Write me an email</div>
					<p class="mt-2 text-sm text-palette-brightest-white/60">
						Tell me what you’re working on. A few sentences are enough to start.
					</p>
				</div>
				<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
					<a href={mailto} class={actionClass}>Open email →</a>
					<button
						type="button"
						data-copy-email={email}
						class="text-palette-brightest-white/60 underline-offset-4 hover:text-palette-brightest-white hover:underline"
					>
						Copy address
					</button>
				</div>
			</div>

			<!-- 2. Call — the lowest-effort route, and the one that was missing -->
			<div class={tileClass}>
				<div>
					<div class="text-palette-brightest-white">Book a call</div>
					<p class="mt-2 text-sm text-palette-brightest-white/60">
						15 minutes, no strings. Pick a slot that suits you.
					</p>
				</div>
				<a
					href={calLink}
					target="_blank"
					rel="noreferrer noopener"
					class={`${actionClass} text-sm`}
				>
					Pick a time →
				</a>
			</div>

			<!-- 3. LinkedIn — for people who want to check you out first -->
			<div class={tileClass}>
				<div>
					<div class="text-palette-brightest-white">Reach out on LinkedIn</div>
					<p class="mt-2 text-sm text-palette-brightest-white/60">
						Rather look me up first? That’s fine — I’m there too.
					</p>
				</div>
				<a
					href={linkedin}
					target="_blank"
					rel="noreferrer noopener"
					class={`${actionClass} text-sm`}
				>
					Open profile →
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	// Copy-to-clipboard is a convenience only: the mailto link next to it always
	// works, so nothing breaks when the Clipboard API is unavailable.
	function bindCopyButtons() {
		for (const button of document.querySelectorAll<HTMLButtonElement>(
			"[data-copy-email]",
		)) {
			if (button.dataset.copyBound === "true") continue;
			button.dataset.copyBound = "true";

			button.addEventListener("click", async () => {
				const address = button.dataset.copyEmail ?? "";
				const original = button.textContent;

				try {
					await navigator.clipboard.writeText(address);
					button.textContent = "Copied";
				} catch {
					button.textContent = address;
				}

				setTimeout(() => {
					button.textContent = original;
				}, 2000);
			});
		}
	}

	bindCopyButtons();
	// View transitions swap the DOM, so re-bind after every navigation.
	document.addEventListener("astro:after-swap", bindCopyButtons);
</script>
