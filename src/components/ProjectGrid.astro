---
/**
 * The project grid on home and Archive: a tight masonry, three columns on a
 * big screen, two on a tablet, one on a phone. Every image keeps its own
 * shape, so tall posters and wide screens both show uncropped, and the small
 * gaps put more work on the first screen.
 *
 * The cards are rendered in order. A short script deals them into columns,
 * each one to the shortest column, so the order still reads left to right,
 * top to bottom. Without JavaScript the same cards fall back to a plain grid.
 */
import type { Project } from "../lib/projects";
import ProjectBadge from "./ProjectBadge.astro";
import ProjectTags from "./ProjectTags.astro";

interface Props {
	projects: Project[];
	/** How many of the first cards load eagerly (they are on the first screen). */
	priority?: number;
	/** Most columns on a big screen. 2 makes a single card half the width. */
	columns?: 2 | 3;
	[key: string]: unknown;
}

const { projects, priority = 3, columns = 3, class: className, ...rest } = Astro.props;

// Matches the column breakpoints below.
const sizes = "(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 420px";
---

<div class:list={["project-grid", className]} data-masonry data-max-cols={columns} {...rest}>
	{
		projects.map((project, i) => {
			const image = project.imageItems[0];
			const ratio =
				image.width && image.height ? image.height / image.width : 0.75;
			return (
				<a
					href={`/project/${project.slug}/`}
					class="project-card project-preview"
					data-tags={project.tags.join("|")}
					data-ratio={ratio.toFixed(4)}
				>
					<div
						class="card-media"
						style={
							image.width && image.height
								? `aspect-ratio: ${image.width} / ${image.height}`
								: undefined
						}
					>
						<img
							src={image.src}
							srcset={image.srcSet}
							sizes={sizes}
							alt={image.alt ?? project.name}
							width={image.width}
							height={image.height}
							loading={i < priority ? "eager" : "lazy"}
							fetchpriority={i < priority ? "high" : undefined}
							decoding="async"
						/>
						<ProjectBadge label={project.badge} />
					</div>
					{/* relative: the topic chips hang off the bottom of this row
					    and rise into view on hover. */}
					<div class="relative">
						<div class="card-meta">
							<span class="card-tagline">{project.tagline}</span>
							<span class="card-year">{project.year}</span>
						</div>
						<ProjectTags tags={project.tags} />
					</div>
				</a>
			);
		})
	}
</div>

<style>
	/* Fallback without JavaScript: a plain grid with the same gaps. */
	.project-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--grid-gap-y) var(--grid-gap);
		align-items: start;
		--grid-gap: 0.75rem;
		/* More between rows than between columns: under each image there is
		   the description, and on hover the topics rise below it, so the next
		   picture starts after room for both. */
		--grid-gap-y: 3.25rem;
	}

	@media (min-width: 640px) {
		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.project-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.project-grid.is-masonry {
		display: flex;
		align-items: flex-start;
		gap: var(--grid-gap);
	}

	.project-grid :global(.masonry-col) {
		flex: 1 1 0;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--grid-gap-y);
	}

	.project-card {
		display: block;
		min-width: 0;
	}

	.project-card[hidden] {
		display: none;
	}

	.card-media {
		position: relative;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 6%, transparent);
	}

	.card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-meta {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin-top: 0.375rem;
		font-size: 0.8rem;
		line-height: 1.4;
		min-width: 0;
	}

	.card-tagline {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--color-secondary-foreground);
	}

	.card-year {
		flex-shrink: 0;
		color: var(--color-secondary-foreground);
	}

</style>

<script>
	/*
	 * Deal the cards into columns. Heights are known up front from each
	 * image's aspect ratio, so this runs before any image has loaded and the
	 * layout never jumps. It runs again when the column count changes and when
	 * the Archive filter hides or shows cards ("masonry:layout").
	 */
	function columnCount(grid?: HTMLElement) {
		const max = Number(grid?.dataset.maxCols ?? 3);
		if (window.innerWidth >= 1024) return max;
		if (window.innerWidth >= 640) return 2;
		return 1;
	}

	// Description row and the gap below it, as a share of the card width.
	const META = 0.2;

	function layout(grid: HTMLElement) {
		const cards =
			(grid as any).__cards ??
			((grid as any).__cards = [...grid.querySelectorAll<HTMLElement>(".project-card")]);
		const count = columnCount(grid);

		grid.querySelectorAll(".masonry-col").forEach((col) => col.remove());

		if (count === 1) {
			grid.classList.remove("is-masonry");
			for (const card of cards) grid.append(card);
			grid.dataset.cols = "1";
			return;
		}

		const cols = Array.from({ length: count }, () => {
			const col = document.createElement("div");
			col.className = "masonry-col";
			grid.append(col);
			return { col, height: 0 };
		});

		for (const card of cards) {
			if (card.hidden) {
				cols[0].col.append(card);
				continue;
			}
			const shortest = cols.reduce((a, b) => (b.height < a.height - 0.01 ? b : a));
			shortest.col.append(card);
			shortest.height += Number(card.dataset.ratio ?? 0.75) + META;
		}

		grid.classList.add("is-masonry");
		grid.dataset.cols = String(count);
	}

	function bindMasonry() {
		for (const grid of document.querySelectorAll<HTMLElement>("[data-masonry]")) {
			layout(grid);
			if (grid.dataset.bound === "true") continue;
			grid.dataset.bound = "true";
			grid.addEventListener("masonry:layout", () => layout(grid));
		}
	}

	let resizeFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(() => {
			for (const grid of document.querySelectorAll<HTMLElement>("[data-masonry]")) {
				if (grid.dataset.cols !== String(columnCount(grid))) layout(grid);
			}
		});
	});

	bindMasonry();
	document.addEventListener("astro:after-swap", bindMasonry);
</script>
