---
/**
 * Discipline chips for a project card.
 *
 * They sit just under the project description and ride up from below on hover,
 * so the grid stays quiet until you actually look at something. Absolutely
 * positioned on purpose — showing them must never reflow the grid.
 *
 * The parent card needs `class="project-card"` and `position: relative`.
 */
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tag-strip" aria-hidden="true">
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	/*
	 * On touch there is no hover, so the chips are always on show and take up
	 * real space in the card. That stops them from spilling over the next
	 * project in a single-column phone layout.
	 */
	.tag-strip {
		margin: var(--space-xs) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		list-style: none;
		pointer-events: none;
	}

	/* A lighter fill than the button chips, so a label never reads as something
	   you can press. */
	.tag-strip li {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 8%, transparent);
		padding: 0.2rem 0.6rem;
		font-size: 0.75rem;
		line-height: 1.4;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 65%, transparent);
		white-space: nowrap;
	}

	/* Where hovering exists, the chips lift out of the flow and ride up on hover,
	   so the grid stays quiet until you look at a card. */
	@media (hover: hover) {
		.tag-strip {
			position: absolute;
			top: 100%;
			inset-inline: 0;
			margin-top: var(--space-xs);
			transform: translateY(0.6rem);
			opacity: 0;
			transition:
				transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
				opacity 0.25s ease;
		}

		.tag-strip li {
			transform: translateY(0.4rem);
			transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}

		/* Chips stagger in, so it reads as one movement rather than a block. */
		.tag-strip li:nth-child(2) {
			transition-delay: 0.05s;
		}

		.tag-strip li:nth-child(3) {
			transition-delay: 0.1s;
		}

		:global(.project-card):hover .tag-strip,
		:global(.project-card):focus-visible .tag-strip {
			transform: translateY(0);
			opacity: 1;
		}

		:global(.project-card):hover .tag-strip li,
		:global(.project-card):focus-visible .tag-strip li {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-strip,
		.tag-strip li {
			transform: none;
			transition: opacity 0.2s ease;
		}
	}
</style>
