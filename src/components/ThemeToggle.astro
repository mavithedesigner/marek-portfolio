---
// Only the mode word is interactive, the leading copy is plain text.
---

<p class="text-sm text-secondary-foreground">
	set website to <button
		type="button"
		id="theme-toggle"
		class="text-palette-brightest-white hover:underline focus:outline-none focus-visible:underline"
	>light_mode</button>
</p>

<script>
	// The label always names the mode you'd switch TO.
	function syncLabel(button: HTMLButtonElement) {
		const isLight = document.documentElement.dataset.theme === "light";
		button.textContent = isLight ? "dark_mode" : "light_mode";
	}

	function setupThemeToggle() {
		const button = document.getElementById("theme-toggle") as HTMLButtonElement | null;
		if (!button || button.dataset.bound === "true") return;
		button.dataset.bound = "true";

		syncLabel(button);

		let clearFallback: number | undefined;

		function applyTheme(next: "light" | "dark", button: HTMLButtonElement) {
			const root = document.documentElement;

			// Dark is the base, so it carries no attribute at all.
			if (next === "dark") {
				delete root.dataset.theme;
			} else {
				root.dataset.theme = next;
			}

			try {
				localStorage.setItem("theme", next);
			} catch (_) {
				/* private mode, the choice just won't persist */
			}

			syncLabel(button);
		}

		button.addEventListener("click", () => {
			const root = document.documentElement;
			const next = root.dataset.theme === "light" ? "dark" : "light";
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			// Dropping focus stops the browser trying to keep the button in view.
			button.blur();

			/*
			 * Preferred path: the browser takes a snapshot of the whole page, we swap
			 * the theme, and it cross-fades the old picture into the new one. Because
			 * it is one image fading into another, nothing can fall out of step. The
			 * header, the logo and the body all change together by definition.
			 */
			const startViewTransition = (
				document as Document & {
					startViewTransition?: (callback: () => void) => { finished: Promise<void> };
				}
			).startViewTransition;

			if (!reduceMotion && typeof startViewTransition === "function") {
				root.classList.add("theme-switching");

				const transition = startViewTransition.call(document, () =>
					applyTheme(next, button),
				);

				transition.finished.finally(() => {
					root.classList.remove("theme-switching");
				});

				return;
			}

			/*
			 * Fallback for browsers without view transitions: give everything a
			 * temporary colour transition instead.
			 *
			 * The computed-style read below is load-bearing. A transition only runs
			 * when it was already part of the element's style BEFORE the value
			 * changed. Without forcing a style recalculation here, the class and the
			 * new colour land in the same pass and the page simply snaps.
			 */
			root.classList.add("theme-transition");
			window.clearTimeout(clearFallback);
			clearFallback = window.setTimeout(() => {
				root.classList.remove("theme-transition");
			}, 400);

			void window.getComputedStyle(root).transitionDuration;

			applyTheme(next, button);
		});
	}

	setupThemeToggle();
	// View transitions swap the page, so re-bind after every navigation.
	document.addEventListener("astro:page-load", setupThemeToggle);
</script>
