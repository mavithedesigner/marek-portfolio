---
import { getProjects } from "../lib/projects";
import ProjectGrid from "./ProjectGrid.astro";

// Every project, not a handful: the grid is tight enough that the first
// screen already shows several, and the rest are one scroll away.
const projects = await getProjects();
---

<!-- Same frame as the header, so the grid lines up with the logo and Contact. -->
<div class="w-full max-w-7xl mx-auto bg-background text-palette-brightest-white px-4 pt-2 pb-4 sm:pb-8">
    <ProjectGrid projects={projects} />
    <div class="flex justify-center px-4 pt-10 sm:pt-12 md:pt-16">
        <a
            href="/archive/"
            aria-label="See full archive"
            class="-my-3 py-3 text-sm font-mono text-palette-brightest-white hover:text-white hover:underline transition-colors duration-300"
            >see_full_archive</a
        >
    </div>
</div>
