---
import { Image } from "astro:assets";
import background from "../assets/contact.png";
import CallToAction from "./CallToAction.astro";

const {
	imageSrc = background,
	imageAlt = "Abstract line artwork",
	imageCaption = "theline.png",
	// One honest line about availability removes the "is it even worth writing?" doubt.
	availability = "Currently taking on new projects.",
} = Astro.props;
---

<section class="w-full max-w-7xl mx-auto mt-44 mb-10">
	<div class="container mx-auto px-4">
		<div class="flex flex-col md:flex-row gap-12 items-start md:items-center justify-between">
			<div class="w-full md:w-auto text-left">
				<h2 class="text-base font-mono text-secondary-foreground">Contact</h2>
				<p class="mt-4 max-w-sm text-lg text-palette-brightest-white">
					Have a project in mind? There are three ways to reach me — pick
					whichever suits you.
				</p>
				<p class="mt-3 text-sm text-palette-brightest-white/60">{availability}</p>
			</div>

			<div>
				<div class="bg-black/60 max-w-xl">
					<Image src={imageSrc} alt={imageAlt} class="w-full h-auto aspect-[4/3] object-cover" />
				</div>
				<div class="mt-2">
					<p class="text-sm">{imageCaption}</p>
				</div>
			</div>
		</div>

		<CallToAction variant="inline" class="mt-16" heading="Get in touch" />
	</div>
</section>
