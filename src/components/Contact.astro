---
import { Image } from "astro:assets";
import background from "../assets/contact.png";
import CallToAction from "./CallToAction.astro";

const {
	imageSrc = background,
	imageAlt = "Abstract line artwork",
	imageCaption = "theline.png",
	// One honest line about availability removes the "is it even worth writing?" doubt.
	availability = "Currently taking on new projects.",
	// The contact page passes its own spacing so the block fits one screen.
	spacing = "section-gap",
	// Only where the block is above the fold (the contact page); on the home
	// page it sits far down and should stay lazy.
	eager = false,
	// The home page only points to the contact page with one button; the three
	// ways to reach me live on the contact page itself.
	options = true,
} = Astro.props;
---

<section class={`w-full max-w-7xl mx-auto ${spacing}`}>
	<div class="container mx-auto px-4">
		<div class="flex flex-col md:flex-row gap-12 items-start md:items-center justify-between">
			<div class="w-full md:w-auto text-left">
				<h2 class="text-base font-mono text-secondary-foreground">Contact</h2>
				<p class="mt-4 max-w-sm text-lg text-palette-brightest-white">
					{options
						? "There are three ways to reach me, pick whichever suits you."
						: "Have a project in mind?"}
				</p>
				<p class="mt-3 text-sm text-palette-brightest-white/60">{availability}</p>
				{!options && (
					<!-- Same chip as Contact in the header. -->
					<a
						href="/contact"
						class="mt-6 inline-block rounded-none bg-palette-brightest-white/15 px-3 py-1.5 text-palette-brightest-white transition-colors hover:bg-palette-brightest-white/35 focus:outline-none focus-visible:bg-palette-brightest-white/35"
					>
						Contact
					</a>
				)}
			</div>

			<!-- A definite width: in a column with items-start (and as a flex item
			     on md+) an unsized wrapper is as wide as its content, which is
			     nothing until the image arrives, so the image used to pop open and
			     push everything around it. -->
			<div class="w-full max-w-xl md:w-1/2 md:shrink-0">
				<div class="bg-black/60">
					<!-- Capped against the viewport so the whole block still fits one
					     screen on a 13" laptop. -->
					<Image
						src={imageSrc}
						alt={imageAlt}
						loading={eager ? "eager" : "lazy"}
						class="w-full h-auto max-h-[38svh] aspect-[4/3] object-cover"
					/>
				</div>
				<div class="mt-2">
					<p class="text-sm">{imageCaption}</p>
				</div>
			</div>
		</div>

		{options && <CallToAction variant="inline" class="mt-16" heading="" intro="" />}
	</div>
</section>
