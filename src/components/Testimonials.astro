---
/**
 * Client quotes, as a horizontal slider.
 *
 * Renders nothing until at least one entry in `src/data/testimonials.json` has
 * `published: true` and a non-empty quote, so a half-collected list can sit in
 * the repo without ever showing a placeholder on the live site.
 *
 * Photos are optional. Drop a file in `src/assets/testimonials/` and point
 * `avatar` at its filename; without one the card falls back to initials.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import rawTestimonials from "../data/testimonials.json";

type Testimonial = {
	published: boolean;
	quote: string;
	name: string;
	role?: string;
	company?: string;
	/** Filename inside `src/assets/testimonials/`. */
	avatar?: string;
	/** Optional project slug, so the quote can link to the case it came from. */
	project?: string;
};

interface Props {
	heading?: string;
	/** Hard cap on how many to show. */
	limit?: number;
	/** Only quotes attached to this project slug. */
	project?: string;
	class?: string;
}

const {
	heading = "What others say",
	limit = 6,
	project,
	class: className = "",
} = Astro.props;

const testimonials = (rawTestimonials as Testimonial[])
	.filter((item) => item.published && item.quote.trim().length > 0)
	.filter((item) => (project ? item.project === project : true))
	.slice(0, limit);

const avatarModules = import.meta.glob("../assets/testimonials/*.{png,jpg,jpeg,webp}", {
	eager: true,
}) as Record<string, { default: ImageMetadata }>;

async function resolveAvatar(filename?: string) {
	if (!filename) return null;

	const entry = Object.entries(avatarModules).find(
		([path]) => path.split("/").pop() === filename,
	);

	if (!entry) return null;

	const image = await getImage({
		src: entry[1].default,
		width: 112,
		height: 112,
		fit: "cover",
		format: "webp",
		quality: 85,
	});

	return image.src;
}

function initials(name: string) {
	return name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("");
}

const cards = await Promise.all(
	testimonials.map(async (item) => ({
		...item,
		avatarSrc: await resolveAvatar(item.avatar),
	})),
);

/*
 * Looping needs three identical copies: the viewer sits in the middle one and
 * whenever they wander out of it the scroll position is snapped back by exactly
 * one copy. The content either side is the same, so the jump is invisible.
 * Only worth it once there are enough quotes to fill the row.
 */
const canLoop = cards.length >= 3;
const rendered = canLoop ? [...cards, ...cards, ...cards] : cards;

const labelClass =
	"uppercase tracking-[0.18em] text-[0.7rem] text-palette-brightest-white/60";
---

{
	cards.length > 0 && (
		<section
			class={`testimonials w-full max-w-7xl mx-auto ${className}`}
			aria-labelledby="testimonials-heading"
		>
			<div class="container mx-auto px-4">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<h2 id="testimonials-heading" class={labelClass}>
						{heading}
					</h2>

					{cards.length > 1 && (
						<div class="slider-nav">
							<button type="button" data-slide="prev" aria-label="Previous quote">
								←
							</button>
							<button type="button" data-slide="next" aria-label="Next quote">
								→
							</button>
						</div>
					)}
				</div>

				<ul
					class={`slider ${cards.length === 1 ? "slider--single" : ""}`}
					data-testimonial-slider
					data-loop={canLoop ? "true" : "false"}
					data-count={cards.length}
				>
					{rendered.map((item, i) => (
						<li class="slide" aria-hidden={i >= cards.length ? "true" : undefined}>
							<figure>
								<blockquote>“{item.quote}”</blockquote>

								<figcaption>
									<span class="avatar">
										{item.avatarSrc ? (
											<img src={item.avatarSrc} alt="" width="56" height="56" loading="lazy" />
										) : (
											<span class="avatar-fallback">{initials(item.name)}</span>
										)}
									</span>

									<span>
										<span class="who">{item.name}</span>
										<span class="where">
											{[item.role, item.company].filter(Boolean).join(", ")}
										</span>
										{/* No link when the quote already sits on that project's page. */}
										{item.project && !project && (
											<a
												href={`/project/${item.project}`}
												class="case-link"
												tabindex={i >= cards.length ? -1 : undefined}
											>
												See the project →
											</a>
										)}
									</span>
								</figcaption>
							</figure>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	/* Arrows are clickable, so they are allowed to look like controls. */
	.slider-nav {
		display: flex;
		gap: 0.5rem;
	}

	.slider-nav button {
		width: 2.25rem;
		height: 2.25rem;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		transition: background-color 0.2s ease;
	}

	.slider-nav button:hover:not(:disabled) {
		background: color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
	}

	.slider-nav button:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.slider {
		display: flex;
		gap: var(--space-md);
		margin: var(--space-lg) 0 0;
		padding: 0 0 0.5rem;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		overscroll-behavior-x: contain;
	}

	.slider::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 85%;
		scroll-snap-align: start;
	}

	@media (min-width: 768px) {
		.slide {
			flex-basis: calc((100% - 2 * var(--space-md)) / 3);
		}
	}

	/* A lone quote, as on a project page, gets the full width instead of sitting
	   in a third of the row looking like something is missing. */
	.slider--single .slide {
		flex-basis: 100%;
	}

	.slider--single blockquote {
		font-size: 1.05rem;
	}

	.slide figure {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.5rem;
		height: 100%;
		margin: 0;
	}

	/* No box: a quote is not a button. The rule carries the eye instead. */
	.slide blockquote {
		margin: 0;
		padding-left: 1rem;
		border-left: 2px solid
			color-mix(in srgb, var(--color-palette-brightest-white) 35%, transparent);
		color: color-mix(in srgb, var(--color-palette-brightest-white) 90%, transparent);
		line-height: 1.6;
	}

	.slide figcaption {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		font-size: 0.875rem;
	}

	.avatar,
	.avatar img,
	.avatar-fallback {
		display: block;
		width: 3.5rem;
		height: 3.5rem;
		flex-shrink: 0;
		border-radius: 9999px;
		object-fit: cover;
	}

	.avatar-fallback {
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--color-palette-brightest-white) 15%, transparent);
		color: var(--color-palette-brightest-white);
		font-size: 0.9rem;
		letter-spacing: 0.05em;
	}

	.who {
		display: block;
		color: var(--color-palette-brightest-white);
	}

	.where {
		display: block;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
	}

	.case-link {
		display: inline-block;
		margin-top: 0.35rem;
		color: color-mix(in srgb, var(--color-palette-brightest-white) 60%, transparent);
		text-underline-offset: 4px;
	}

	.case-link:hover {
		color: var(--color-palette-brightest-white);
		text-decoration: underline;
	}
</style>

<script>
	function bindTestimonialSliders() {
		for (const slider of document.querySelectorAll<HTMLElement>(
			"[data-testimonial-slider]",
		)) {
			if (slider.dataset.sliderBound === "true") continue;
			slider.dataset.sliderBound = "true";

			const section = slider.closest("section");
			const prev = section?.querySelector<HTMLButtonElement>('[data-slide="prev"]');
			const next = section?.querySelector<HTMLButtonElement>('[data-slide="next"]');
			const slides = [...slider.querySelectorAll<HTMLElement>(".slide")];
			const count = Number(slider.dataset.count ?? slides.length);
			const loop = slider.dataset.loop === "true" && slides.length >= count * 3;

			// Width of one full copy, measured rather than calculated, so the flex
			// gap between copies is accounted for exactly.
			const copyWidth = () =>
				loop && slides[count] ? slides[count].offsetLeft - slides[0].offsetLeft : 0;

			// One card plus the gap, so a click always lands on a card edge.
			const step = () =>
				slides[0] ? slides[0].getBoundingClientRect().width + 24 : 320;

			/** Move without animating, with snapping off so it can't fight the jump. */
			function jumpTo(left: number) {
				const snap = slider.style.scrollSnapType;
				slider.style.scrollSnapType = "none";
				slider.scrollLeft = left;
				requestAnimationFrame(() => {
					slider.style.scrollSnapType = snap;
				});
			}

			function recentre() {
				if (!loop) return;
				const one = copyWidth();
				if (one <= 0) return;

				if (slider.scrollLeft >= one * 2) jumpTo(slider.scrollLeft - one);
				else if (slider.scrollLeft < one) jumpTo(slider.scrollLeft + one);
			}

			function sync() {
				if (loop) return; // With looping there is no end to run into.
				const max = slider.scrollWidth - slider.clientWidth - 1;
				if (prev) prev.disabled = slider.scrollLeft <= 0;
				if (next) next.disabled = slider.scrollLeft >= max;
			}

			prev?.addEventListener("click", () => {
				slider.scrollBy({ left: -step(), behavior: "smooth" });
			});

			next?.addEventListener("click", () => {
				slider.scrollBy({ left: step(), behavior: "smooth" });
			});

			/*
			 * Re-centring is deferred until scrolling settles. Moving the position
			 * mid-animation would cut a smooth scroll short; once it has stopped the
			 * jump lands on identical content and cannot be seen.
			 */
			let settle: number | undefined;

			slider.addEventListener(
				"scroll",
				() => {
					sync();
					window.clearTimeout(settle);
					settle = window.setTimeout(recentre, 140);
				},
				{ passive: true },
			);

			window.addEventListener("resize", () => {
				sync();
				recentre();
			});

			// Start inside the middle copy so there is room to go either way.
			if (loop) {
				requestAnimationFrame(() => jumpTo(copyWidth()));
			}

			sync();
		}
	}

	bindTestimonialSliders();
	document.addEventListener("astro:after-swap", bindTestimonialSliders);
</script>
